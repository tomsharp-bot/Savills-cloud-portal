# Local default matches docker-compose.yml
DATABASE_URL=postgresql://portal:portal@localhost:5432/savills_cloud_portal?schema=public

# Long random string in production (App Platform env var)
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000
NODE_ENV=development

# DigitalOcean Spaces — later (private bucket cloud-portal-vault, LON1)
# Do not put real keys in the repo.
SPACES_ENDPOINT=
SPACES_REGION=lon1
SPACES_BUCKET=cloud-portal-vault
SPACES_KEY=
SPACES_SECRET=
