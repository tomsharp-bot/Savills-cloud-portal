# Copy to .env for local use. On DigitalOcean App Platform, set these
# in the app's Environment Variables — never commit real values.

# Must be a real postgresql:// or postgres:// URI — not a ${db.DATABASE_URL} placeholder.
DATABASE_URL=postgresql://portal:portal@localhost:5432/savills_cloud_portal?schema=public
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
PORT=3000

# Public URL prefix. Leave empty or "/" for local http://localhost:3000
# On DigitalOcean production set: BASE_PATH=/projectprogress
# (APP_BASE_PATH is accepted as an alias.)
BASE_PATH=

# DigitalOcean Spaces — private bucket cloud-portal-vault (lon1).
# Production (NODE_ENV=production) stores Reference Documents ONLY here.
# If endpoint, key, or secret is missing in production, uploads fail.
# They are not written to uploads/reference-documents/ (that disk is wiped on redeploy).
# Local development may leave KEY and SECRET blank to use that disk instead.
# Do not commit SPACES_KEY or SPACES_SECRET.
SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
SPACES_REGION=lon1
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=cloud-portal-vault
# Set true to require Spaces even when NODE_ENV is not production.
# Production always requires Spaces, whether this is set or not.
REQUIRE_SPACES=

# Ideal Postcodes — server-side address + UPRN lookup on the public HHSRS site form
# (Find address on /HHSRS-site-form/new). Leave blank to disable lookup.
# The form then tells the surveyor that lookup is not configured.
# Set this as an encrypted environment variable on DigitalOcean App Platform.
# Do not commit a real key. The key is never sent to the browser.
IDEAL_POSTCODES_API_KEY=
