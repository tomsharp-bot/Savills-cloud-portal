generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  surveyor
  client
}

enum ProjectStage {
  current
  upcoming
  archive
}

enum AssetKind {
  dwelling
  block
  garage
}

enum ProjectTargetUnit {
  count
  percent
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  passwordHash      String
  role              Role
  name              String
  email             String?
  initials          String?
  agency            String?
  company           String?
  clientRole        String?
  frozen            Boolean  @default(false)
  lastTempPassword  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  access            ProjectAccess[]
}

model Project {
  id                   String            @id @default(cuid())
  name                 String            @unique
  projectManager       String
  stage                ProjectStage      @default(upcoming)
  typeConditionOnly    Boolean           @default(true)
  typeConditionEpc     Boolean           @default(false)
  typeBlocks           Boolean           @default(true)
  typeGarages          Boolean           @default(true)
  typeCommercial       Boolean           @default(false)
  typeOther            Boolean           @default(false)
  typeValidations      Boolean           @default(false)
  projectTargetValue   Int               @default(75)
  projectTargetUnit    ProjectTargetUnit @default(percent)
  sampleStartDate      String            @default("")
  sampleTargetEndDate  String            @default("")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  access               ProjectAccess[]
  assets               Asset[]
  patchSamples         PatchSample[]
  visitLogs            VisitLog[]
  loaderHistory        LoaderHistory[]
  completions          Completion[]
  documents            ProjectDocument[]
  externalLink         ExternalLink?
  hhsrsSiteSubmissions HhsrsSiteSubmission[]
  programmeSurveyNote  ProgrammeSurveyNote?
  photoPoolItems       PhotoPoolItem[]
  photoFolders         PhotoFolder[]
  photoShareTokens     PhotoShareToken[]
}

/// Shared Projects Programme grid (one row). Cell text, Active ticks, and row order.
model ProgrammeBoard {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")
}

/// Admin edits to the Programme "Survey types" cell. Absent row = seed from Project type ticks.
model ProgrammeSurveyNote {
  projectId   String   @id
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  surveyTypes String   @default("")
  updatedAt   DateTime @updatedAt
}

/// Admin-edited Sample Analysis labels for one stock patch on a project.
model PatchSample {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  patch            String
  areaName         String   @default("")
  surveyorInitials String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, patch])
  @@index([projectId])
}

model ProjectAccess {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model Asset {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         AssetKind
  uprn         String
  assetStatus  String    @default("No Visit")
  surveyDate   String    @default("")
  surveyedBy   String    @default("")
  visit1       String    @default("")
  visit2       String    @default("")
  visit3       String    @default("")
  number       String    @default("")
  block        String    @default("")
  street       String    @default("")
  area         String    @default("")
  city         String    @default("")
  postcode     String    @default("")
  archetype    String    @default("")
  yearBuilt    String    @default("")
  patch        String    @default("")
  surveyor     String    @default("")
  surveyType     String    @default("")
  /// Admin flag: this dwelling needs an EPC as well as the condition survey.
  epcRequired    Boolean   @default(false)
  siteComments   String    @default("")
  external       String    @default("")
  residentName   String    @default("")
  residentNumber String    @default("")
  residentEmail  String    @default("")
  letterDate1    String    @default("")
  letterDate2    String    @default("")
  x1             String    @default("")
  x2             String    @default("")
  x3             String    @default("")
  omitAsset      Boolean   @default(false)
  stockMissing   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([projectId, kind, uprn])
  @@index([projectId, kind])
  @@index([projectId, uprn])
}

model VisitLog {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceId        String   @default("")
  uprn            String
  combinedAddress String   @default("")
  visitType       String   @default("")
  dataSource      String   @default("")
  surveyDate      String   @default("")
  nextSurvey      String   @default("")
  accessType      String   @default("")
  createdBy       String   @default("")
  createdOn       String   @default("")
  surveyDesign    String   @default("")
  visitDate       String   @default("")
  number          String   @default("")
  block           String   @default("")
  addressLine1    String   @default("")
  addressLine5    String   @default("")
  postcode        String   @default("")
  archetype       String   @default("")
  loadedFrom      String   @default("")
  loadedAt        DateTime @default(now())

  @@index([projectId, uprn])
}

model LoaderHistory {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  when      DateTime @default(now())
  file      String
  target    String
  result    String
}

model Completion {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String
  generatedAt DateTime @default(now())
  status      String   @default("Ready")
}

/// Photos Pool row for a project. spacesKey empty = coloured placeholder.
/// A pool key is shown through the authenticated /photos image route, not a public Spaces URL.
model PhotoPoolItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Usually UPRN-room-seq e.g. 2245623-Kitchen-1
  code      String
  fileName  String
  /// Spaces object key when live; empty means demo / placeholder thumb
  spacesKey String   @default("")
  /// Incremented when the stored bytes are replaced in place (GDPR blur) so image URLs change.
  revision  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([projectId, code])
  @@index([projectId])
  @@index([projectId, createdAt])
}

/// Excel photo-share grant for one project's Photos Pool. The secret is not stored.
/// Callers keep the plaintext once; lookup uses tokenHash.
model PhotoShareToken {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdBy String    @default("")
  createdAt DateTime  @default(now())
  label     String    @default("")

  @@index([projectId])
}

/// Photo Folders / zip packs. Client Access → Project Progress Completions.
model PhotoFolder {
  id           String                @id @default(cuid())
  projectId    String
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  /// folder | zip
  kind         String                @default("folder")
  /// Display size for zip packs (e.g. "320 MB"); folders use photo count instead
  sizeLabel    String                @default("")
  clientAccess Boolean               @default(false)
  /// Photo codes copied from the pool (JSON string[])
  photoCodes   Json                  @default("[]")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  activities   PhotoFolderActivity[]

  @@index([projectId])
  @@index([projectId, clientAccess])
}

model PhotoFolderActivity {
  id           String      @id @default(cuid())
  folderId     String
  folder       PhotoFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  who          String
  downloaded   Boolean     @default(false)
  downloadedAt DateTime?
  userId       String      @default("")

  @@index([folderId])
}

/// Linked External-only UPRN set (Spaces XLOOKUP later — persist in DB for now)
model ExternalLink {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String
  flagCol   String   @default("External")
  uprns     Json
  linkedAt  DateTime @default(now())
}

/// Local disk files under uploads/projects/{id}/ — TODO: Spaces cloud-portal-vault / LON1
model ProjectDocument {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  storedName String
  type       String
  size       Int
  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([projectId])
}

/// Site-raised HHSRS issue (surveyor phone form). Original photos stay on local disk.
/// When the case is marked actioned, a copy is indexed here and stored in Spaces.
/// Office review / client-email draft fields are edited in /HHSRSreporter.
model HhsrsSiteSubmission {
  id                   String    @id @default(cuid())
  projectId            String?
  project              Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName          String
  surveyDate           String
  uprn                 String
  fullAddress          String
  postcode             String
  surveyorName         String
  category             String
  rating               String
  comment              String
  clientCallReference  String    @default("")
  otherDetails         String    @default("")
  photoPaths           Json
  /// Office workflow: new | in_review | email_ready | email_sent | closed
  status               String    @default("new")
  /// Concise client-facing hazard wording (office-edited). Empty → derive from comment.
  clientDescription    String    @default("")
  /// Call outcome for templates that need it (Onward etc.): Completed | Attempted | Not yet called | Not required | ""
  callOutcome          String    @default("")
  /// Why a call was attempted but not completed. Reporter Review and Generate email read this as Call notes.
  callNotes            String    @default("")
  workOrder            String    @default("")
  suspectedCause       String    @default("")
  includeCause         Boolean   @default(true)
  vulnerabilities      String    @default("")
  escalation           String    @default("")
  onwardTopic          String    @default("")
  cat1Confirmed        Boolean   @default(false)
  internalNotes        String    @default("")
  emailSubject         String    @default("")
  emailBody            String    @default("")
  emailSentAt          DateTime?
  emailSentBy          String    @default("")
  /// Office claim. Empty claimedBy means the case is open. Stale is derived from claimedAt — never auto-stolen.
  claimedBy            String    @default("")
  claimedAt            DateTime?
  lastEditedBy         String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  completedPhotos      HhsrsCompletedPhoto[]
  photoCopy            HhsrsPhotoCopy?
  sentEmails           HhsrsSentEmail[]

  @@index([createdAt])
  @@index([projectId])
  @@index([status])
}

/// One logged HHSRS photo copied into Spaces under HHSRS - Completed.
/// The address is kept on the row so Photo Storage can search it. Disk originals are not removed.
model HhsrsCompletedPhoto {
  id           String              @id @default(cuid())
  submissionId String
  submission   HhsrsSiteSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  projectId    String?
  /// Project Progress name. No HHSRS or damp/mould wording is added.
  projectName  String
  uprn         String
  fullAddress  String              @default("")
  postcode     String              @default("")
  /// Display address, including postcode when that was stored separately.
  addressLine  String              @default("")
  /// Short address used in the Spaces folder name.
  shortAddress String              @default("")
  fileName     String
  /// Relative path under the upload directory, e.g. hhsrs-site-form/{id}/{file}
  sourcePath   String
  spacesKey    String
  contentType  String              @default("")
  copiedAt     DateTime            @default(now())

  @@unique([submissionId, sourcePath])
  @@index([projectName, uprn])
  @@index([projectName])
  @@index([uprn])
}

/// Latest copy attempt for a logged case. A failed row can be retried without logging again.
model HhsrsPhotoCopy {
  submissionId String              @id
  submission   HhsrsSiteSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// copied | failed
  status       String
  error        String              @default("")
  copiedCount  Int                 @default(0)
  failedCount  Int                 @default(0)
  updatedAt    DateTime            @updatedAt
}

/// One row per portal send. A future Sent emails tab and resend can list every version.
/// Person-initiated only — nothing in the app sends on a timer.
model HhsrsSentEmail {
  id            String              @id @default(cuid())
  submissionId  String
  submission    HhsrsSiteSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sentAt        DateTime            @default(now())
  sentBy        String
  from          String
  to            String
  cc            String              @default("")
  bcc           String              @default("")
  subject       String              @default("")
  body          String              @default("")
  photoNames    Json
  messageId     String              @default("")
  sentCopySaved Boolean             @default(false)
  sentCopyError String              @default("")

  @@index([submissionId])
  @@index([sentAt])
}

/// Office archive flag for HHSRS Reporter → Project overview.
/// Colin seed-archived names stay archived until a row sets archived to false.
model HhsrsReporterProjectArchive {
  name      String   @id
  archived  Boolean  @default(true)
  completed Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Shared reference library (admins + surveyors). Not project-scoped and never shown to clients.
/// Production bytes live only in Spaces (spacesKey set). An empty spacesKey is local-dev disk
/// and is not read or written when NODE_ENV=production or REQUIRE_SPACES=true.
model ReferenceDocument {
  id         String   @id @default(cuid())
  /// general | blocks | hhsrs | rdsap | new-starter | other
  category   String
  name       String
  storedName String
  /// File extension: pdf, doc, docx, xls, xlsx, png, jpg, jpeg
  type       String
  size       Int
  uploadedBy String
  uploadedAt DateTime @default(now())
  spacesKey  String   @default("")

  @@index([category])
}
