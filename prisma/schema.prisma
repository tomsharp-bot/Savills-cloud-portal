generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  surveyor
  client
}

enum ProjectStage {
  current
  upcoming
  archive
}

enum AssetKind {
  dwelling
  block
  garage
}

enum ProjectTargetUnit {
  count
  percent
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  passwordHash      String
  role              Role
  name              String
  email             String?
  initials          String?
  agency            String?
  company           String?
  clientRole        String?
  frozen            Boolean  @default(false)
  lastTempPassword  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  access            ProjectAccess[]
}

model Project {
  id                   String            @id @default(cuid())
  name                 String            @unique
  projectManager       String
  stage                ProjectStage      @default(upcoming)
  typeConditionOnly    Boolean           @default(true)
  typeConditionEpc     Boolean           @default(false)
  typeBlocks           Boolean           @default(true)
  typeGarages          Boolean           @default(true)
  typeCommercial       Boolean           @default(false)
  typeOther            Boolean           @default(false)
  typeValidations      Boolean           @default(false)
  projectTargetValue   Int               @default(75)
  projectTargetUnit    ProjectTargetUnit @default(percent)
  sampleStartDate      String            @default("")
  sampleTargetEndDate  String            @default("")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  access               ProjectAccess[]
  assets               Asset[]
  patchSamples         PatchSample[]
  visitLogs            VisitLog[]
  loaderHistory        LoaderHistory[]
  completions          Completion[]
  documents            ProjectDocument[]
  externalLink         ExternalLink?
  hhsrsSiteSubmissions HhsrsSiteSubmission[]
}

/// Admin-edited Sample Analysis labels for one stock patch on a project.
model PatchSample {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  patch            String
  areaName         String   @default("")
  surveyorInitials String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, patch])
  @@index([projectId])
}

model ProjectAccess {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model Asset {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         AssetKind
  uprn         String
  assetStatus  String    @default("No Visit")
  surveyDate   String    @default("")
  surveyedBy   String    @default("")
  visit1       String    @default("")
  visit2       String    @default("")
  visit3       String    @default("")
  number       String    @default("")
  block        String    @default("")
  street       String    @default("")
  area         String    @default("")
  city         String    @default("")
  postcode     String    @default("")
  archetype    String    @default("")
  yearBuilt    String    @default("")
  patch        String    @default("")
  surveyor     String    @default("")
  surveyType     String    @default("")
  /// Admin flag: this dwelling needs an EPC as well as the condition survey.
  epcRequired    Boolean   @default(false)
  siteComments   String    @default("")
  external       String    @default("")
  residentName   String    @default("")
  residentNumber String    @default("")
  residentEmail  String    @default("")
  letterDate1    String    @default("")
  letterDate2    String    @default("")
  x1             String    @default("")
  x2             String    @default("")
  x3             String    @default("")
  omitAsset      Boolean   @default(false)
  stockMissing   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([projectId, kind, uprn])
  @@index([projectId, kind])
  @@index([projectId, uprn])
}

model VisitLog {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceId        String   @default("")
  uprn            String
  combinedAddress String   @default("")
  visitType       String   @default("")
  dataSource      String   @default("")
  surveyDate      String   @default("")
  nextSurvey      String   @default("")
  accessType      String   @default("")
  createdBy       String   @default("")
  createdOn       String   @default("")
  surveyDesign    String   @default("")
  visitDate       String   @default("")
  number          String   @default("")
  block           String   @default("")
  addressLine1    String   @default("")
  addressLine5    String   @default("")
  postcode        String   @default("")
  archetype       String   @default("")
  loadedFrom      String   @default("")
  loadedAt        DateTime @default(now())

  @@index([projectId, uprn])
}

model LoaderHistory {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  when      DateTime @default(now())
  file      String
  target    String
  result    String
}

model Completion {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String
  generatedAt DateTime @default(now())
  status      String   @default("Ready")
}

/// Linked External-only UPRN set (Spaces XLOOKUP later — persist in DB for now)
model ExternalLink {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String
  flagCol   String   @default("External")
  uprns     Json
  linkedAt  DateTime @default(now())
}

/// Local disk files under uploads/projects/{id}/ — TODO: Spaces cloud-portal-vault / LON1
model ProjectDocument {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  storedName String
  type       String
  size       Int
  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([projectId])
}

/// Site-raised HHSRS issue (surveyor phone form). Photos on local disk for now.
/// TODO: Spaces cloud-portal-vault / LON1
model HhsrsSiteSubmission {
  id                   String   @id @default(cuid())
  projectId            String?
  project              Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName          String
  surveyDate           String
  uprn                 String
  fullAddress          String
  postcode             String
  surveyorName         String
  category             String
  rating               String
  comment              String
  clientCallReference  String   @default("")
  otherDetails         String   @default("")
  photoPaths           Json
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([projectId])
}
