{
  "name": "savills-cloud-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Savills Cloud Portal — Mark Up / stock-condition survey progress tracker",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/views dist/public && cp -r views/. dist/views/ && cp -r public/. dist/public/",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "test": "tsx --test src/lib/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.18.6",
    "bcryptjs": "^3.0.2",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "prisma": "^6.16.1",
    "typescript": "^5.9.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
