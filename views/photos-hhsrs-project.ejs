<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= projectName %> — HHSRS - Completed — Savills Cloud Portal</title>
  <%- include("partials/head-css") %>
  <link rel="stylesheet" href="<%= baseUrl('/css/photos.css') %>" />
</head>
<body>
<div id="screen-app" class="photos-page">
  <%- include("partials/topbar") %>
  <%- include("partials/admin-hub", { active: "photos" }) %>
  <main class="wrap">
    <div class="breadcrumb-mini">
      <a href="<%= baseUrl('/photos') %>">Photo Storage</a>
      · <a href="<%= baseUrl('/photos#section-hhsrs') %>">HHSRS - Completed</a>
      · <%= projectName %>
    </div>
    <div class="project-head">
      <div>
        <h2><%= projectName %></h2>
        <p class="project-lead">Lead: <strong><%= leadFirst %></strong></p>
        <p class="intro" style="margin-top:4px">From Project Progress. Properties are listed in numerical UPRN order, with each property's photos shown under its heading. Click a photo to view it full size.</p>
      </div>
      <div>
        <a class="btn" href="<%= baseUrl('/photos#section-hhsrs') %>">← Back to Photo Storage</a>
      </div>
    </div>

    <div class="section-bar">
      <h2>Properties</h2>
      <span class="meta"><%= properties.length %> <%= properties.length === 1 ? "property" : "properties" %></span>
    </div>
    <p class="sort-note">Sorted by UPRN (numerical).</p>
    <% if (!properties.length) { %>
      <div class="empty-state">No properties copied for this project yet.</div>
    <% } else { %>
      <div class="hhsrs-uprn-list">
        <% properties.forEach(function (row) { %>
          <section class="hhsrs-uprn-block">
            <div class="hhsrs-uprn-head">
              <h3>UPRN <%= row.uprn %></h3>
              <p class="hhsrs-uprn-address"><%= row.address || "Address not recorded" %></p>
            </div>
            <% if (!row.photos || !row.photos.length) { %>
              <div class="empty-state">No photos for this UPRN.</div>
            <% } else { %>
              <div class="photo-grid" role="list">
                <% row.photos.forEach(function (photo) {
                  const sub = ["UPRN " + photo.uprn, photo.address || row.address, projectName].filter(Boolean).join(" · ");
                %>
                  <button type="button" class="photo-card" role="listitem" data-photo-open data-src="<%= baseUrl(photo.imageUrl) %>" data-title="<%= photo.fileName %>" data-sub="<%= sub %>" aria-label="<%= photo.fileName %>">
                    <img class="photo-thumb-img" src="<%= baseUrl(photo.imageUrl) %>" alt="" loading="lazy" decoding="async" />
                    <div class="photo-name"><%= photo.fileName %></div>
                    <div class="hhsrs-copied-at"><%= photo.copiedAtLabel %></div>
                    <div class="photo-meta">UPRN <%= photo.uprn %></div>
                  </button>
                <% }) %>
              </div>
            <% } %>
          </section>
        <% }) %>
      </div>
    <% } %>
  </main>
  <%- include("partials/photo-lightbox") %>
</div>
<script src="<%= baseUrl('/js/hhsrs-completed-photos.js') %>"></script>
</body>
</html>
