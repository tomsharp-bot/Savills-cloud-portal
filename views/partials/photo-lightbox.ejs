<div class="lightbox-backdrop" id="photoLightbox" role="dialog" aria-modal="true" aria-labelledby="lightboxTitle" hidden>
  <div class="lightbox">
    <div class="lightbox-head">
      <div>
        <h3 id="lightboxTitle">Photo</h3>
        <p class="lightbox-sub" id="lightboxSub"></p>
      </div>
      <button type="button" class="modal-close" id="btnCloseLightbox" aria-label="Close">×</button>
    </div>
    <div class="lightbox-body">
      <img id="lightboxImg" alt="" />
    </div>
    <div class="lightbox-foot">
      <button type="button" class="btn btn-primary" id="btnLightboxOk">Close</button>
    </div>
  </div>
</div>
