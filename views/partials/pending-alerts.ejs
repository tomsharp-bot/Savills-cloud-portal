<% if (typeof isAdmin !== "undefined" && isAdmin) { %>
<link rel="stylesheet" href="<%= baseUrl('/css/hhsrs-pending-alerts.css') %>" />
<div class="hhsrs-home-alert is-fixed" id="hhsrs-home-alert" role="status" hidden>
  <span class="hhsrs-home-alert-text" id="hhsrs-home-alert-text">New HHSRS case waiting in Pending</span>
  <a class="hhsrs-home-alert-link" id="hhsrs-home-alert-link" href="<%= baseUrl('/HHSRSreporter') %>">Open Pending</a>
  <button type="button" class="hhsrs-home-alert-dismiss" id="hhsrs-home-alert-dismiss">Dismiss</button>
</div>
<div class="hhsrs-alerts-paused is-fixed" id="hhsrs-alerts-paused" role="status" hidden>Alerts are paused. The login may have expired.</div>
<script>
  window.HHSRS_PENDING_ALERTS = window.HHSRS_PENDING_ALERTS || {
    base: "/HHSRSreporter",
    surface: "portal",
    alertsPollMs: 30000
  };
</script>
<script src="<%= baseUrl('/js/hhsrs-pending-alerts.js') %>" defer></script>
<% } %>
