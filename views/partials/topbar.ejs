<header class="topbar">
  <a class="brand" href="<%= baseUrl(isAdmin ? '/admin' : (isSurveyor ? '/surveyor' : '/projects')) %>">Savills Cloud Portal</a>
  <div class="right">
    <a class="linkish" href="<%= baseUrl('/projects') %>">Projects Progress</a>
    <% if (isAdmin) { %><a class="linkish" href="<%= baseUrl('/projects-programme') %>">Programme</a><% } %>
    <% if (isAdmin || isSurveyor) { %><a class="linkish" href="<%= baseUrl('/reference-documents') %>">Reference Documents</a><% } %>
    <% if (isAdmin) { %><a class="linkish" href="<%= baseUrl('/personnel') %>">Personnel</a><% } %>
    <% if (isAdmin) { %><a class="linkish" href="<%= baseUrl('/HHSRSreporter') %>">HHSRS Reporter</a><% } %>
    <% if (isAdmin) { %><a class="linkish" href="<%= baseUrl('/photos') %>">Photo Storage</a><% } %>
    <% if (isAdmin) { %><a class="linkish" href="<%= baseUrl('/hhsrs-submissions') %>">HHSRS site reports</a><% } %>
    <% if (canSeeDataChecks) { %><a class="linkish data-checks-nav" href="<%= baseUrl('/data-checks') %>"<% if (dataChecksActive) { %> aria-current="page"<% } %>>Data Checks</a><% } %>
    <span><%= user.name %> <span class="role-pill"><%= roleLabel %></span></span>
    <a class="linkish" href="<%= baseUrl('/account/password') %>">Change password</a>
    <form class="inline-form" method="post" action="<%= baseUrl('/logout') %>">
      <button type="submit" class="linkish">Log out</button>
    </form>
  </div>
</header>
