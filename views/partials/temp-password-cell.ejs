<td class="col-pw">
  <div class="temp-pw-row">
    <% if (person.lastTempPassword) { %>
      <code class="temp-pw"><%= person.lastTempPassword %></code>
      <button type="button" class="btn btn-ghost btn-sm btn-copy" data-copy="<%= person.lastTempPassword %>">Copy</button>
    <% } else { %>
      <span class="temp-pw muted">Set by user</span>
    <% } %>
    <form class="inline-form" method="post" action="<%= baseUrl('/personnel/' + person.id + '/reset-password') %>" onsubmit="return confirm('Issue a new temporary password? The user will need it to log in. Any previous password cannot be revealed.');">
      <button class="btn btn-ghost btn-sm" type="submit">Reset</button>
    </form>
  </div>
</td>
