<%
  const cols = stockColsByKind[kind];
  const labels = stockLabels;
  const selectCols = stockSelectCols;
  const title = kind === "dwelling" ? "Dwellings" : kind === "block" ? "Blocks" : "Garages";
  const filters = typeof stockFilters !== "undefined" && stockFilters ? stockFilters : {};
  const options = typeof stockFilterOptions !== "undefined" && stockFilterOptions ? stockFilterOptions : {};
  const sort = typeof stockSort !== "undefined" ? stockSort : "uprn";
  const dir = typeof stockDir !== "undefined" ? stockDir : "asc";
  const pageInfo = typeof stockPage !== "undefined" ? stockPage : { page: 1, pageCount: 1, matched: 0, total: 0, offset: 0 };
  const countLabel = typeof stockLabel !== "undefined" ? stockLabel : ((rows || []).length + " Assets");
  const windowSize = typeof stockWindowSize !== "undefined" ? stockWindowSize : 100;
  const rowHeight = typeof stockRowHeight !== "undefined" ? stockRowHeight : 40;
  const matchedCount = typeof stockMatched !== "undefined" ? stockMatched : (pageInfo.matched || 0);
  const offsetCount = typeof stockOffset !== "undefined" ? stockOffset : (pageInfo.offset || 0);
  const filterClass = (value) => String(value || "").trim() ? "filter-active" : "";
%>
<div class="stock-tab-head">
  <h3><%= title %></h3>
  <p class="stock-count" data-stock-count="<%= kind %>"><%= countLabel %></p>
</div>
<p style="margin:0;color:var(--muted);font-size:.9rem"><% if (isAdmin && kind === "dwelling") { %>Site Comments editable by surveyor. Resident, letter and X fields are Admin-only. Filters and sorting cover every asset in this tab — scroll the list; only the rows in view are drawn.<% } else { %>Site Comments editable by surveyor · all other columns locked. Filters and sorting cover every asset in this tab — scroll the list; only the rows in view are drawn.<% } %></p>
<div class="stock-tools">
  <button type="button" class="btn btn-ghost btn-sm" data-clear-filters="<%= kind %>">Clear All Filters</button>
  <% if (!isClient) { %>
    <a class="btn btn-ghost btn-sm" href="<%= baseUrl('/projects/' + project.id + '/stock/export?scope=' + kind) %>">Export this tab</a>
    <a class="btn btn-ghost btn-sm" href="<%= baseUrl('/projects/' + project.id + '/stock/export?scope=all') %>">Export all stock</a>
  <% } %>
  <% if (isAdmin) { %>
    <button type="button" class="btn btn-danger btn-sm" data-clear-stock>Clear entire stocklist</button>
  <% } %>
</div>
<div class="stock-table-wrap">
  <table class="stock-table" data-stock="<%= kind %>" data-project="<%= project.id %>"
         data-offset="<%= offsetCount %>" data-limit="<%= windowSize %>"
         data-matched="<%= matchedCount %>" data-total="<%= pageInfo.total || 0 %>"
         data-row-height="<%= rowHeight %>"
         data-sort="<%= sort %>" data-dir="<%= dir %>">
    <thead>
      <tr class="stock-head">
        <% cols.forEach(c => { %>
          <th class="<%= c === 'siteComments' ? 'col-site-comments' : '' %>">
            <button type="button" class="sort-link <%= sort === c ? 'active' : '' %>" data-sort-col="<%= c %>" data-sort-label="<%= labels[c] %>">
              <%= labels[c] %><% if (sort === c) { %> <%= dir === "asc" ? "↑" : "↓" %><% } %>
            </button>
          </th>
        <% }) %>
      </tr>
      <tr class="col-filter-row" data-stock-filters="<%= kind %>">
        <% cols.forEach(c => { %>
          <% const current = filters[c] || ""; %>
          <th>
            <% if (c === "omitAsset") { %>
              <select data-filter="omitAsset" class="<%= filterClass(current) %>">
                <option value="">All</option>
                <option value="included" <%= current === "included" ? "selected" : "" %>>Included</option>
                <option value="omitted" <%= current === "omitted" ? "selected" : "" %>>Omitted</option>
              </select>
            <% } else if (c === "epcRequired") { %>
              <select data-filter="epcRequired" class="<%= filterClass(current) %>">
                <option value="">All</option>
                <option value="__nonblank__" <%= current === "__nonblank__" ? "selected" : "" %>>(Non-blanks)</option>
                <option value="YES" <%= current === "YES" ? "selected" : "" %>>YES</option>
                <option value="__blank__" <%= current === "__blank__" ? "selected" : "" %>>(blank)</option>
              </select>
            <% } else if (selectCols.has(c) && Array.isArray(options[c])) { %>
              <select data-filter="<%= c %>" class="<%= filterClass(current) %>">
                <option value="">All</option>
                <option value="__nonblank__" <%= current === "__nonblank__" ? "selected" : "" %>>(Non-blanks)</option>
                <% const vals = options[c] || (c === "assetStatus" && typeof assetStatusOptions !== "undefined" ? assetStatusOptions : []); %>
                <% vals.forEach(v => { const shown = String(v ?? "").trim(); const value = shown ? shown : "__blank__"; %>
                  <option value="<%= value %>" <%= current === value ? "selected" : "" %>><%= shown || "(blank)" %></option>
                <% }) %>
              </select>
            <% } else if (selectCols.has(c)) { %>
              <% const presence = current === "__nonblank__" || current === "__blank__"; %>
              <select data-filter-presence="<%= c %>" class="<%= presence ? "filter-active" : "" %>">
                <option value="">All</option>
                <option value="__nonblank__" <%= current === "__nonblank__" ? "selected" : "" %>>(Non-blanks)</option>
                <option value="__blank__" <%= current === "__blank__" ? "selected" : "" %>>(blank)</option>
              </select>
              <input type="text" data-filter="<%= c %>" class="<%= !presence && current ? "filter-active" : "" %>" value="<%= presence ? "" : current %>" placeholder="Filter" />
            <% } else { %>
              <input type="text" data-filter="<%= c %>" class="<%= filterClass(current) %>" value="<%= current %>" placeholder="Filter" />
            <% } %>
          </th>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <%- include("stock-rows", { cols: cols, rows: rows }) %>
    </tbody>
  </table>
</div>
