<%
  const cols = stockColsByKind[kind];
  const labels = stockLabels;
  const selectCols = stockSelectCols;
  const dateCols = stockDateCols;
  const title = kind === "dwelling" ? "Dwellings" : kind === "block" ? "Blocks" : "Garages";
  const canComment = isAdmin || isSurveyor;
  const editCols = new Set(typeof adminEditCols !== "undefined" ? adminEditCols : []);
  const displayVal = (row, col) => dateCols.has(col) ? formatStockDate(row[col]) : String(row[col] || "");
%>
<div class="stock-tab-head">
  <h3><%= title %></h3>
  <p class="stock-count" data-stock-count="<%= kind %>"><%= rows.length %> of <%= rows.length %> Assets Displayed</p>
</div>
<p style="margin:0;color:var(--muted);font-size:.9rem"><% if (isAdmin && kind === "dwelling") { %>Site Comments editable by surveyor. Resident, letter and X fields are Admin-only. Per-column filters below headers.<% } else { %>Site Comments editable by surveyor · all other columns locked. Per-column filters below headers.<% } %></p>
<div class="stock-tools">
  <% if (!isClient) { %>
    <a class="btn btn-ghost btn-sm" href="/projects/<%= project.id %>/stock/export?scope=<%= kind %>">Export this tab</a>
    <a class="btn btn-ghost btn-sm" href="/projects/<%= project.id %>/stock/export?scope=all">Export all stock</a>
  <% } %>
  <% if (isAdmin) { %>
    <button type="button" class="btn btn-danger btn-sm" data-clear-stock>Clear entire stocklist</button>
  <% } %>
</div>
<div class="stock-table-wrap">
  <table class="stock-table" data-stock="<%= kind %>" data-project="<%= project.id %>">
    <thead>
      <tr class="stock-head">
        <% cols.forEach(c => { %><th><%= labels[c] %></th><% }) %>
      </tr>
      <tr class="col-filter-row" data-stock-filters="<%= kind %>">
        <% cols.forEach(c => { %>
          <th>
            <% if (c === "omitAsset") { %>
              <select data-filter="omitAsset">
                <option value="">All</option>
                <option value="included">Included</option>
                <option value="omitted">Omitted</option>
              </select>
            <% } else if (selectCols.has(c)) { %>
              <select data-filter="<%= c %>">
                <option value="">All</option>
                <% const vals = [...new Set(rows.map(r => displayVal(r, c)))].sort(); %>
                <% vals.forEach(v => { %><option value="<%= v %>"><%= v || "(blank)" %></option><% }) %>
              </select>
            <% } else { %>
              <input type="text" data-filter="<%= c %>" placeholder="Filter" />
            <% } %>
          </th>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %>
        <tr><td colspan="<%= cols.length %>" class="empty">No assets in this tab yet.</td></tr>
      <% } else { %>
        <% rows.forEach(r => { %>
          <tr class="<%= r.omitAsset ? 'row-omitted' : '' %> <%= r.stockMissing ? 'row-stock-missing' : '' %>"
              data-asset="<%= r.id %>"
              data-omit="<%= r.omitAsset ? '1' : '0' %>">
            <% cols.forEach(c => { %>
              <% if (c === "siteComments") { %>
                <td>
                  <input class="comment-input" data-comment="<%= r.id %>" value="<%= r.siteComments %>" <%= canComment ? "" : "disabled" %> />
                </td>
              <% } else if (c === "omitAsset") { %>
                <td class="omit-cell">
                  <% if (isAdmin) { %>
                    <label><input type="checkbox" data-omit="<%= r.id %>" <%= r.omitAsset ? "checked" : "" %> /> <% if (r.omitAsset) { %><span class="omit-tag">Omitted</span><% } %></label>
                  <% } else { %>
                    <% if (r.omitAsset) { %><span class="omit-tag">Omitted</span><% } %>
                  <% } %>
                </td>
              <% } else if (editCols.has(c) && isAdmin) { %>
                <td data-col="<%= c %>">
                  <input class="comment-input" data-admin-field="<%= c %>" data-asset="<%= r.id %>" value="<%= displayVal(r, c) %>" placeholder="<%= dateCols.has(c) ? 'DD/MM/YY' : '' %>" />
                </td>
              <% } else if (c === "assetStatus") { %>
                <td>
                  <%= r.assetStatus %>
                  <% if (r.stockMissing) { %><span class="stock-missing-tag">Not on latest stocklist</span><% } %>
                </td>
              <% } else { %>
                <td class="locked" data-col="<%= c %>"><%= displayVal(r, c) %></td>
              <% } %>
            <% }) %>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>
