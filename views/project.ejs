<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= project.name %> — Savills Cloud Portal</title>
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
<div id="screen-app">
  <%- include("partials/topbar") %>
  <div class="main">
    <section>
      <div class="toolbar">
        <div>
          <div class="crumb"><a class="linkish dark" href="/projects">← All projects</a></div>
          <h2 class="page-title"><%= project.name %></h2>
          <p class="page-sub">Project Manager: <%= project.projectManager %> · <%= project.stage === 'current' ? 'Current' : project.stage === 'upcoming' ? 'Upcoming' : 'Archive' %></p>
        </div>
        <span class="badge">Live data</span>
      </div>
      <% if (notice) { %><p class="flash flash-ok"><%= notice %></p><% } %>
      <% if (error) { %><p class="flash flash-err"><%= error %></p><% } %>

      <div class="project-layout">
        <nav class="sidebar">
          <% const tabs = [
            ["summary","Summary", true],
            ["dwellings","Dwellings", true],
            ["blocks","Blocks", true],
            ["garages","Garages", true],
            ["hierarchy","Hierarchy", true],
            ["documents","Project Documents", true],
            ["loader","Data Loader", isAdmin],
            ["completions","Completions", false]
          ]; %>
          <% tabs.forEach(([key, label, field]) => { %>
            <% if (isClient && key !== "completions") return; %>
            <% if (isSurveyor && key === "completions") return; %>
            <% if (field && isClient) return; %>
            <% if (key === "loader" && !isAdmin) return; %>
            <a class="tab <%= tab === key ? 'active' : '' %>" href="/projects/<%= project.id %>?tab=<%= key %>"><%= label %></a>
          <% }) %>
        </nav>
        <div class="panel">
          <% if (tab === "summary") { %>
            <h3 style="margin:0 0 4px;color:var(--navy)">Summary</h3>
            <p style="margin:0;color:var(--muted);font-size:.9rem">Tiles follow the survey types switched on for this project.</p>
            <p class="summary-types"><%= typesLine.length ? ("Included: " + typesLine.join(" · ")) : "No survey types selected for this project." %></p>
            <div class="stats">
              <% summary.forEach(col => { %>
                <div class="stat-col <%= col.hidden ? 'hidden' : '' %>">
                  <% col.tiles.forEach(t => { %>
                    <div class="stat"><div class="label"><%= t.label %></div><div class="value"><%= t.value %></div></div>
                  <% }) %>
                </div>
              <% }) %>
            </div>
          <% } %>

          <% if (tab === "dwellings") { %>
            <%- include("partials/stock-table", { kind: "dwelling", rows: dwellings, project }) %>
          <% } %>
          <% if (tab === "blocks") { %>
            <%- include("partials/stock-table", { kind: "block", rows: blocks, project }) %>
          <% } %>
          <% if (tab === "garages") { %>
            <%- include("partials/stock-table", { kind: "garage", rows: garages, project }) %>
          <% } %>

          <% if (tab === "hierarchy") { %>
            <h3 style="margin:0;color:var(--navy)">Hierarchy</h3>
            <div class="placeholder-box">Project structure / hierarchy (placeholder).</div>
          <% } %>

          <% if (tab === "documents") { %>
            <h3 style="margin:0 0 4px;color:var(--navy)">Project Documents</h3>
            <p style="margin:0;color:var(--muted);font-size:.9rem">Excel, Word and PDF. Surveyors can open/download; only Admins can upload or delete.</p>
            <% if (isAdmin) { %>
            <form class="docs-toolbar" method="post" action="/projects/<%= project.id %>/documents" enctype="multipart/form-data">
              <input type="file" name="file" accept=".xlsx,.xls,.doc,.docx,.pdf" required />
              <button type="submit" class="btn btn-primary btn-sm">Upload</button>
            </form>
            <% } else { %>
            <p class="docs-hint">You can download or open files. Upload and delete are Admin-only.</p>
            <% } %>
            <p class="docs-hint">Stored on local disk at <code>uploads/projects/<%= project.id %>/</code>. TODO: move to DigitalOcean Spaces bucket <strong>cloud-portal-vault</strong> (LON1).</p>
            <div style="overflow-x:auto">
              <table class="docs-table">
                <thead>
                  <tr><th>Name</th><th>Type</th><th>Size</th><th>Uploaded by</th><th>Date</th><th>Actions</th></tr>
                </thead>
                <tbody>
                  <% if (!documents.length) { %>
                    <tr><td colspan="6" class="empty">No documents yet.</td></tr>
                  <% } else { %>
                    <% documents.forEach(d => { %>
                      <tr>
                        <td><%= d.name %></td>
                        <td><%= d.type %></td>
                        <td><%= formatBytes(d.size) %></td>
                        <td><%= d.uploadedBy %></td>
                        <td><%= formatDocDate(d.uploadedAt) %></td>
                        <td>
                          <a class="btn btn-ghost btn-sm" href="/projects/<%= project.id %>/documents/<%= d.id %>/view" target="_blank">View</a>
                          <a class="btn btn-ghost btn-sm" href="/projects/<%= project.id %>/documents/<%= d.id %>/download">Download</a>
                          <% if (isAdmin) { %>
                          <form class="inline-form" method="post" action="/projects/<%= project.id %>/documents/<%= d.id %>/delete" onsubmit="return confirm('Delete <%= d.name %>?');">
                            <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                          </form>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } %>

          <% if (tab === "loader" && isAdmin) { %>
            <h3 style="margin:0 0 4px;color:var(--navy)">Data Loader</h3>
            <p style="margin:0;color:var(--muted);font-size:.9rem">Drop the daily Excel — use the <strong>Asset Visits</strong> sheet (or Data). UPRN is the match key. With <strong>Auto</strong>, rows route to Dwellings / Blocks / Garages from Survey Design / Archetype / type fields. Each Apply <strong>appends</strong> to the Visit Log (never replaces).</p>
            <form id="loader-form" method="post" action="/projects/<%= project.id %>/loader" enctype="multipart/form-data">
              <div class="loader-drop" id="loader-drop" tabindex="0">
                <strong>Drag Excel here</strong>
                <p>or click to choose · .xlsx / .xls / .csv</p>
                <input type="file" id="loader-file" name="file" accept=".xlsx,.xls,.csv" hidden />
              </div>
              <div class="stock-tools">
                <label for="loader-target">Load into</label>
                <select id="loader-target" name="target">
                  <option value="dwellings">Dwellings</option>
                  <option value="blocks">Blocks</option>
                  <option value="garages">Garages</option>
                  <option value="auto" selected>Auto (Dwellings / Blocks / Garages)</option>
                </select>
                <button type="submit" class="btn btn-primary" id="btn-loader-apply" disabled>Apply to stock</button>
              </div>
            </form>
            <form method="post" action="/projects/<%= project.id %>/loader/demo" class="stock-tools">
              <input type="hidden" name="target" value="auto" />
              <button type="submit" class="btn btn-ghost">Load demo visits</button>
            </form>
            <div class="loader-map">
              <table>
                <thead><tr><th>Your Excel column (example)</th><th>Portal field</th></tr></thead>
                <tbody>
                  <tr><td>UPRN</td><td>UPRN (match key)</td></tr>
                  <tr><td>Combined Address</td><td>Number / Street / Postcode (parsed)</td></tr>
                  <tr><td>Survey Date</td><td>Visit Date → Visit 1 / 2 / 3 (first 3, oldest first)</td></tr>
                  <tr><td>Access Type</td><td>Drives Asset Status (see rules)</td></tr>
                  <tr><td>Created By</td><td>Surveyor · Surveyed By (initials match)</td></tr>
                  <tr><td>Visit Type</td><td>Presence ends “No Visit” default</td></tr>
                  <tr><td>Data Source / Next Survey / Created On / Survey Design</td><td>Kept on Visit Log</td></tr>
                </tbody>
              </table>
            </div>
            <div class="loader-rules">
              <h4 style="margin:12px 0 6px;color:var(--navy);font-size:.95rem">Asset Status &amp; visit rules</h4>
              <ul style="margin:0;padding-left:18px;color:var(--muted);font-size:.88rem;line-height:1.45">
                <li>Default Asset Status = <strong>No Visit</strong> until a Visit Type appears in the upload.</li>
                <li>Access Type <strong>No Answer</strong> or <strong>None</strong> → Asset Status <strong>No Access</strong>; Survey Date &amp; Surveyed By stay blank.</li>
                <li>Access Type <strong>Failed Appointment</strong> (any visit number) → Asset Status <strong>Appt Made Not Kept</strong>; Survey Date &amp; Surveyed By stay blank.</li>
                <li>Access Type <strong>Refused Access</strong> or <strong>Not Convenient</strong> → Asset Status <strong>Access Refused</strong>; Visit Date is stored in the Visit 1/2/3 chain; Survey Date &amp; Surveyed By stay blank.</li>
                <li>Access Type <strong>Void</strong> → Asset Status <strong>Void</strong>; Visit Date added to the visit chain; Survey Date &amp; Surveyed By stay blank.</li>
                <li>Access Type <strong>Successful</strong> → Asset Status <strong>Full Survey</strong>; Survey Date = Visit Date of that Successful row; Surveyed By = surveyor initials from Created By (Personnel match); Full Surveys Completed ticks +1.</li>
                <li>Many visits allowed in the file; portal shows only the <strong>first three</strong> dates, oldest → Visit 1, next → Visit 2, next → Visit 3.</li>
              </ul>
            </div>
            <p class="loader-log" id="loader-log">Choose an Excel/CSV or use “Load demo visits”.</p>
            <div class="loader-history-wrap">
              <table>
                <thead><tr><th>When</th><th>File</th><th>Target</th><th>Result</th></tr></thead>
                <tbody>
                  <% if (!loaderHistory.length) { %>
                    <tr><td colspan="4" class="empty">Load history will appear here.</td></tr>
                  <% } else { %>
                    <% loaderHistory.forEach(h => { %>
                      <tr>
                        <td><%= formatDocDate(h.when) %></td>
                        <td><%= h.file %></td>
                        <td><%= h.target %></td>
                        <td><%= h.result %></td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>

            <div class="stock-refresh-box">
              <h4>Upload or refresh stocklist</h4>
              <p style="margin:0 0 8px;color:var(--muted);font-size:.88rem">Drop a stock Excel/CSV with a <strong>UPRN</strong> column. The first upload on an empty project loads the full list. Later uploads add new UPRNs and mark removed ones mid-job (they stay as “Not on latest stocklist”). Compares against the selected target tab above (Auto → Dwellings). New rows start as Asset Status “No Visit”. If a removed row is already <strong>Full Survey</strong> or <strong>Ext-Only</strong>, a Site Comment “Omitted but already surveyed” is added and they still count as completed. Other removals can be omitted from counts (checkbox). Visit history on matching UPRNs is preserved. Use <strong>Export stocklist</strong> to download the current grids, edit Patch / Surveyor, and re-upload here. On Dwellings, Resident Name / Number / Email, Letter Date 1 / 2 and X1–X3 are imported when those columns are in the file (header names can vary slightly). Use <strong>Remove assets not on latest stocklist</strong> to permanently delete those marked rows (you choose whether completed Full Survey / Ext-Only rows go too).</p>
              <form class="stock-tools" method="post" action="/projects/<%= project.id %>/stock-refresh" enctype="multipart/form-data">
                <input type="file" id="stock-refresh-file" name="file" accept=".xlsx,.xls,.csv" required />
                <input type="hidden" name="target" id="stock-refresh-target" value="auto" />
                <label class="chk" for="stock-refresh-omit-removed"><input type="checkbox" id="stock-refresh-omit-removed" name="omitRemoved" value="true" checked /> Also omit removed assets from counts</label>
                <button type="submit" class="btn btn-primary" id="btn-stock-refresh-apply">Apply stocklist</button>
              </form>
              <div class="stock-tools">
                <a class="btn btn-ghost btn-sm" href="/projects/<%= project.id %>/stock/export?scope=all">Export stocklist</a>
                <button type="button" class="btn btn-danger btn-sm" data-purge-missing>Remove assets not on latest stocklist</button>
                <button type="button" class="btn btn-danger btn-sm" data-clear-stock>Clear entire stocklist</button>
              </div>
              <% if (flashRefresh) { %>
              <div class="stock-refresh-results">
                <div class="stock-refresh-panel">
                  <h5>Added: <span class="count"><%= flashRefresh.added.length %></span></h5>
                  <ul>
                    <% if (!flashRefresh.added.length) { %><li class="empty">None</li><% } %>
                    <% flashRefresh.added.forEach(u => { %><li><%= u %></li><% }) %>
                  </ul>
                </div>
                <div class="stock-refresh-panel">
                  <h5>Removed: <span class="count"><%= flashRefresh.removed.length %></span></h5>
                  <ul>
                    <% if (!flashRefresh.removed.length) { %><li class="empty">None</li><% } %>
                    <% flashRefresh.removed.forEach(u => { %><li><%= u %></li><% }) %>
                  </ul>
                </div>
              </div>
              <% } %>
            </div>

            <div class="external-link-box">
              <h4 style="margin:16px 0 6px;color:var(--navy);font-size:.95rem">External-only list</h4>
              <p style="margin:0 0 8px;color:var(--muted);font-size:.88rem">Link an Excel/CSV with UPRN + an External flag column (Yes / True / Y / 1). Matching UPRNs get <strong>External = Yes</strong> and Asset Status <strong>Ext-Only</strong>; visit dates stay put. The linked UPRN set is stored in Postgres and re-applied when an admin logs in or opens this project. TODO: pull the file from Spaces bucket <strong>cloud-portal-vault</strong> (LON1).</p>
              <form class="stock-tools" method="post" action="/projects/<%= project.id %>/external" enctype="multipart/form-data">
                <input type="file" name="file" accept=".xlsx,.xls,.csv" required />
                <label for="external-flag-col">Flag column</label>
                <input id="external-flag-col" name="flagCol" type="text" value="<%= externalLink ? externalLink.flagCol : 'External' %>" placeholder="e.g. External" style="width:120px" />
                <button type="submit" class="btn btn-primary">Link &amp; apply External list</button>
              </form>
              <form method="post" action="/projects/<%= project.id %>/external/clear" class="stock-tools">
                <button type="submit" class="btn btn-ghost">Clear link</button>
              </form>
              <p class="loader-log">
                <% if (externalLink) { %>
                  Linked: <%= externalLink.fileName %> · <%= Array.isArray(externalLink.uprns) ? externalLink.uprns.length : 0 %> flagged UPRN(s). Auto-refreshes on admin login / project open.
                <% } else { %>
                  No External list linked yet.
                <% } %>
              </p>
            </div>

            <div class="visit-log-wrap">
              <div class="visit-log-head">
                <h4>Cumulative Visit Log</h4>
                <p class="visit-log-count"><%= visitLogs.length %> visit<%= visitLogs.length === 1 ? "" : "s" %> logged</p>
              </div>
              <div class="visit-log-tools">
                <input type="search" id="visit-log-filter" placeholder="Filter visit log…" />
              </div>
              <div class="visit-log-table-wrap">
                <table class="visit-log-table" id="visit-log-table">
                  <thead>
                    <tr>
                      <th>ID</th><th>UPRN</th><th>Combined Address</th><th>Visit Type</th><th>Data Source</th>
                      <th>Survey Date</th><th>Next Survey</th><th>Access Type</th><th>Created By</th><th>Created On</th><th>Survey Design</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!visitLogs.length) { %>
                      <tr><td colspan="11" class="empty">No visits logged yet. Apply a file or load demo rows.</td></tr>
                    <% } else { %>
                      <% visitLogs.forEach(v => { %>
                        <tr>
                          <td><%= v.sourceId %></td>
                          <td><%= v.uprn %></td>
                          <td title="<%= v.combinedAddress %>"><%= v.combinedAddress %></td>
                          <td><%= v.visitType %></td>
                          <td><%= v.dataSource %></td>
                          <td><%= v.surveyDate %></td>
                          <td><%= v.nextSurvey %></td>
                          <td><%= v.accessType %></td>
                          <td><%= v.createdBy %></td>
                          <td><%= v.createdOn %></td>
                          <td><%= v.surveyDesign %></td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } %>

          <% if (tab === "completions" && !isSurveyor) { %>
            <h3 style="margin:0 0 4px;color:var(--navy)">Completions</h3>
            <p style="margin:0;color:var(--muted);font-size:.9rem">Completion reports and exports for this project. Clients can view and download only.</p>
            <div style="overflow-x:auto">
              <table class="completions-table">
                <thead>
                  <tr><th>Report</th><th>Type</th><th>Generated</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                  <% if (!completions.length) { %>
                    <tr><td colspan="5" class="empty">No completion reports yet.</td></tr>
                  <% } else { %>
                    <% completions.forEach(c => { %>
                      <tr>
                        <td><%= c.name %></td>
                        <td><%= c.type %></td>
                        <td><%= formatDocDate(c.generatedAt) %></td>
                        <td><%= c.status %></td>
                        <td>
                          <a class="btn btn-ghost btn-sm" href="/projects/<%= project.id %>/completions/<%= c.id %>/view" target="_blank">View</a>
                          <a class="btn btn-ghost btn-sm" href="/projects/<%= project.id %>/completions/<%= c.id %>/download">Download</a>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  </div>
</div>
<% if (isAdmin) { %>
<div id="modal-clear-stock" class="modal-back hidden">
  <div class="modal">
    <h3>Clear entire stocklist</h3>
    <div id="clear-step-1">
      <p>Are you sure? This deletes all dwellings, blocks and garages for this project. Summary counts will update. The visit log is kept unless you choose otherwise on the next step.</p>
      <div class="actions">
        <button type="button" class="btn btn-ghost" data-close="modal-clear-stock">Cancel</button>
        <button type="button" class="btn btn-danger" id="clear-stock-next">Continue</button>
      </div>
    </div>
    <div id="clear-step-2" class="hidden">
      <p>Type <strong>CLEAR</strong> to confirm.</p>
      <label for="clear-stock-typed">Confirm</label>
      <input id="clear-stock-typed" type="text" autocomplete="off" placeholder="CLEAR" />
      <label class="chk"><input type="checkbox" id="clear-stock-wipe-log" /> Also delete visit log</label>
      <form id="form-clear-stock" method="post" action="/projects/<%= project.id %>/stock/clear">
        <input type="hidden" name="confirm" id="clear-stock-confirm-field" value="" />
        <input type="hidden" name="wipeVisitLog" id="clear-stock-wipe-field" value="" />
      </form>
      <div class="actions">
        <button type="button" class="btn btn-ghost" data-close="modal-clear-stock">Cancel</button>
        <button type="button" class="btn btn-danger" id="clear-stock-confirm">Clear stocklist</button>
      </div>
    </div>
  </div>
</div>
<div id="modal-purge-missing" class="modal-back hidden">
  <div class="modal">
    <h3>Remove assets not on latest stocklist</h3>
    <div id="purge-step-1">
      <p>Are you sure you want to remove assets marked “Not on latest stocklist”? This permanently deletes those dwellings, blocks and garages from this project. Summary counts will update. Completed Full Survey / Ext-Only rows stay unless you say otherwise on the next step.</p>
      <div class="actions">
        <button type="button" class="btn btn-ghost" data-close="modal-purge-missing">Cancel</button>
        <button type="button" class="btn btn-danger" id="purge-missing-next">Continue</button>
      </div>
    </div>
    <div id="purge-step-2" class="hidden">
      <p><strong>Purge completed dwellings not on latest stocklist too?</strong></p>
      <p>The same rule applies to Blocks and Garages that are already surveyed (Full Survey / Ext-Only).</p>
      <label class="chk"><input type="radio" name="purge-completed-choice" value="no" checked /> No — keep completed rows</label>
      <label class="chk"><input type="radio" name="purge-completed-choice" value="yes" /> Yes — also delete completed rows</label>
      <form id="form-purge-missing" method="post" action="/projects/<%= project.id %>/stock/purge-missing">
        <input type="hidden" name="confirm" id="purge-missing-confirm-field" value="" />
        <input type="hidden" name="includeCompleted" id="purge-missing-completed-field" value="" />
      </form>
      <div class="actions">
        <button type="button" class="btn btn-ghost" data-close="modal-purge-missing">Cancel</button>
        <button type="button" class="btn btn-danger" id="purge-missing-confirm">Remove assets</button>
      </div>
    </div>
  </div>
</div>
<% } %>
<script src="/js/app.js"></script>
</body>
</html>
