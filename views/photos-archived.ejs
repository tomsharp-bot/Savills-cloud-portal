<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Archived Projects — Photo Storage — Savills Cloud Portal</title>
  <%- include("partials/head-css") %>
  <link rel="stylesheet" href="<%= baseUrl('/css/photos.css') %>" />
</head>
<body>
<div id="screen-app" class="photos-page">
  <%- include("partials/topbar") %>
  <%- include("partials/admin-hub", { active: "photos" }) %>
  <main class="wrap">
    <div class="breadcrumb-mini">
      <a href="<%= baseUrl('/photos') %>">← Back to Current</a>
      · Photos · Archived
    </div>
    <div class="head">
      <div>
        <h1>Archived Projects</h1>
        <p class="intro">Completed programmes kept for reference. Open a tile to view its photo area.</p>
      </div>
      <div>
        <a class="btn" href="<%= baseUrl('/photos') %>">← Back to Current</a>
      </div>
    </div>
    <div class="archived-banner">These projects are finished on Project Progress. Photos stay available here so you can look back without cluttering Current.</div>
    <div class="section-bar">
      <h2>Completed / archived</h2>
      <span class="meta"><%= tiles.length %> completed</span>
    </div>
    <% if (!tiles.length) { %>
      <p class="hint-muted">No archived projects yet.</p>
    <% } else { %>
      <div class="grid" role="list">
        <% tiles.forEach(function (t) { %>
          <a class="tile" role="listitem" href="<%= baseUrl('/photos/projects/' + t.id) %>" aria-label="Open photos for <%= t.name %>">
            <div class="tile-accent <%= t.accent %>"></div>
            <div class="tile-body">
              <div class="tile-name"><%= t.name %></div>
              <div class="tile-lead"><span class="pill archived">Archived</span> Lead: <%= t.leadFirst %></div>
              <% if (t.surveyTypes) { %><div class="tile-survey"><%= t.surveyTypes %></div><% } %>
              <div class="tile-counts">
                <span class="pill">Photos Pool: <%= t.poolCount %></span>
                <span class="pill">Photo Folders: <%= t.folderCount %></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
    <p class="footer-note"><%= spacesHint %></p>
  </main>
</div>
</body>
</html>
