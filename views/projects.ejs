      <rect width="200" height="270" fill="#d9e6f2"></rect>
      <path fill="#f4f7fb" stroke="#1a4b7c" stroke-width="1.4" d="M68.7,56.2 L92.5,58.4 L102.5,64.9 L114.4,76.1 L126.4,79.1 L129.4,86.4 L122.4,93.2 L121.4,103.4 L113.4,110.7 L121.4,117.5 L111.4,120.4 L128.4,120.9 L117.4,124.8 L125.4,132.6 L131.3,142.3 L136.3,152.5 L147.3,158.1 L161.2,167.8 L167.2,176.4 L161.6,179.3 L168.2,183.6 L171.1,190.9 L165.6,194.6 L181.1,192.9 L191.0,195.3 L198.0,203.6 L195.0,210.4 L188.1,219.6 L183.5,227.9 L179.1,231.1 L169.2,230.1 L177.1,233.3 L186.1,234.2 L191.4,235.9 L184.1,241.5 L178.1,244.5 L168.2,248.8 L159.2,248.6 L145.3,248.1 L135.3,250.3 L125.4,252.2 L113.4,252.7 L103.5,254.2 L93.5,259.1 L83.6,261.5 L71.6,261.5 L61.7,265.9 L49.4,264.9 L54.1,261.0 L62.7,256.6 L72.6,252.2 L65.7,243.2 L75.6,238.4 L85.6,237.2 L95.5,237.2 L104.5,231.1 L95.5,232.3 L84.6,230.4 L73.6,228.6 L82.6,226.9 L69.7,226.0 L59.7,226.0 L66.7,220.6 L75.6,214.8 L81.6,208.0 L70.6,204.3 L81.6,199.5 L71.6,194.6 L82.6,189.7 L71.6,186.6 L80.6,183.6 L72.6,186.1 L79.6,189.7 L86.6,186.1 L99.5,185.6 L102.5,182.4 L99.5,171.5 L105.5,165.4 L96.5,159.3 L91.5,154.5 L101.5,150.8 L91.5,147.2 L75.6,152.0 L64.7,148.4 L73.6,142.8 L61.7,140.4 L69.7,133.1 L59.7,130.6 L67.7,122.8 L53.7,120.4 L62.7,113.1 L49.8,108.2 L60.7,105.3 L46.8,99.7 L59.7,94.9 L44.8,88.8 L57.7,83.9 L41.8,79.1 L55.7,74.2 L43.8,68.1 L60.7,62.0 L51.7,58.4 L65.7,56.7 L68.7,56.2 Z"></path>
      <path fill="#f4f7fb" stroke="#1a4b7c" stroke-width="1.4" d="M41.8,139.1 L51.7,139.9 L55.3,144.7 L52.7,149.6 L45.8,156.9 L38.8,159.8 L29.9,161.3 L20.9,158.1 L13.9,152.0 L12.9,144.7 L19.9,139.9 L30.8,138.6 L41.8,139.1 Z"></path>
      <path fill="#f4f7fb" stroke="#1a4b7c" stroke-width="1.2" d="M135.3,3.2 L145.3,4.1 L148.3,10.9 L142.3,15.3 L135.3,13.9 L131.3,9.0 L135.3,3.2 Z"></path>
      <path fill="#f4f7fb" stroke="#1a4b7c" stroke-width="1.2" d="M97.5,39.6 L111.4,40.6 L113.4,47.9 L104.5,49.9 L94.5,46.9 L97.5,39.6 Z"></path>
    </svg>
    <div class="uk-map-pins">
      <% mapPins.forEach(function (pin) { %>
        <button type="button" class="uk-map-pin" style="left:<%= pin.mapX %>%;top:<%= pin.mapY %>%" data-map-pin="<%= pin.id %>" data-saved="1" aria-label="<%= pin.name %>">
          <span class="uk-map-pin-dot" aria-hidden="true"></span>
          <span class="uk-map-pin-label"><%= pin.name %></span>
        </button>
      <% }) %>
    </div>
  </div>
  <% if (isAdmin) { %>
    <label class="uk-map-choose" for="uk-map-project">Choose a project, then click the map</label>
    <select id="uk-map-project">
      <option value="">Project</option>
      <% mapChoices.forEach(function (project) { %>
        <option value="<%= project.id %>"><%= project.name %></option>
      <% }) %>
    </select>
  <% } %>
</aside>
<%- include("partials/app-scripts") %>
<script src="<%= baseUrl('/js/uk-map.js') %>"></script>
</body>
</html>
