<!DOCTYPE html>
<html lang="en-GB">
<head>
  <%- include("partials/head") %>
</head>
<body class="hhsrs-body hhsrs-form-page">
  <div class="stage">
    <div class="play-layout">
      <div class="work-panel">
        <header class="panel-top">
          <div class="hhsrs-logo"><%- include("../partials/logo") %></div>
          <div class="brand-text">
            <p class="eyebrow">Housing · Survey reporting</p>
            <strong>HHSRS Site Reporting</strong>
          </div>
        </header>
        <div class="panel-body">
          <div class="hhsrs-rv">
            <div class="hhsrs-rv-intro">
              <h1>Review issue</h1>
              <p>Check the details below. Nothing is saved until you tap Submit.</p>
            </div>
            <% if (typeof storeError !== "undefined" && storeError) { %>
              <div class="hhsrs-errors" role="alert">
                <p><%= storeError %></p>
              </div>
            <% } %>
            <form id="edit-form" method="post" action="<%= hhsrsUrl('/edit') %>">
              <input type="hidden" name="draftId" value="<%= draft.id %>" />
            </form>
            <% const edit = (jump, title) => `<button class="hhsrs-rv-edit" form="edit-form" type="submit" name="jump" value="${jump}" aria-label="Edit ${title}">Edit</button>`; %>
            <% const r = String(draft.rating || "").toLowerCase(); %>
            <% const tone = (r.startsWith("high") || r === "severe") ? "is-high" : (r === "medium" || r === "moderate") ? "is-mid" : "is-low"; %>

            <section class="hhsrs-rv-card">
              <div class="hhsrs-rv-head"><h2 class="hhsrs-rv-title">Project &amp; visit</h2><%- edit("step-visit", "Project & visit") %></div>
              <dl class="hhsrs-rv-list">
                <div><dt>Project</dt><dd><%= draft.projectName %></dd></div>
                <div><dt>Survey date</dt><dd><%= draft.surveyDate %></dd></div>
                <div><dt>Surveyor</dt><dd><%= draft.surveyorName %></dd></div>
              </dl>
            </section>

            <section class="hhsrs-rv-card">
              <div class="hhsrs-rv-head"><h2 class="hhsrs-rv-title">Property</h2><%- edit("step-property", "Property") %></div>
              <dl class="hhsrs-rv-list">
                <div><dt>UPRN</dt><dd><%= draft.uprn %></dd></div>
                <div><dt>Address</dt><dd><%= draft.fullAddress %></dd></div>
                <div><dt>Postcode</dt><dd><%= draft.postcode %></dd></div>
              </dl>
            </section>

            <section class="hhsrs-rv-card">
              <div class="hhsrs-rv-head"><h2 class="hhsrs-rv-title">Hazard</h2><%- edit("step-hazard", "Hazard") %></div>
              <dl class="hhsrs-rv-list">
                <div><dt>HHSRS category</dt><dd><%= draft.category %></dd></div>
                <div><dt>Rating</dt><dd><span class="hhsrs-rv-pill <%= tone %>"><%= draft.rating %></span></dd></div>
                <div><dt>Comment</dt><dd class="prewrap"><%= draft.comment %></dd></div>
                <% if (draft.cat1Confirmed) { %><div><dt>Category 1 confirmed</dt><dd>Yes</dd></div><% } %>
              </dl>
            </section>

            <section class="hhsrs-rv-card">
              <div class="hhsrs-rv-head"><h2 class="hhsrs-rv-title">Extra details</h2><%- edit("extra-box", "Extra details") %></div>
              <dl class="hhsrs-rv-list">
                <% if (draft.callUnreached) { %>
                  <div><dt>Couldn't get through</dt><dd><%= draft.callRefBlankReason || draft.callUnreachedNote || "—" %></dd></div>
                  <% if (draft.callRefBlankReason && draft.callUnreachedNote) { %>
                    <div><dt>Extra detail</dt><dd class="prewrap"><%= draft.callUnreachedNote %></dd></div>
                  <% } %>
                <% } else if (draft.clientCallReference) { %>
                  <div><dt>Client call reference</dt><dd><%= draft.clientCallReference %></dd></div>
                <% } %>
                <div><dt>Any other details</dt><dd class="prewrap"><%= draft.otherDetails || "—" %></dd></div>
              </dl>
            </section>

            <section class="hhsrs-rv-card">
              <div class="hhsrs-rv-head"><h2 class="hhsrs-rv-title">Photos (<%= draft.photos.length %>)</h2><%- edit("step-photos", "Photos") %></div>
              <div class="hhsrs-rv-photos">
                <% if (!draft.photos.length) { %><p class="hhsrs-hint">No photos attached.</p><% } %>
                <% draft.photos.forEach((p) => { %>
                  <figure><img src="<%= hhsrsUrl('/draft/' + draft.id + '/photo/' + encodeURIComponent(p.storedName)) %>" alt="<%= p.originalName %>" /></figure>
                <% }) %>
              </div>
            </section>

            <div class="hhsrs-rv-actions">
              <button class="hhsrs-btn hhsrs-btn-secondary hhsrs-rv-back" form="edit-form" type="submit">Back</button>
              <form method="post" action="<%= hhsrsUrl('/submit') %>" style="display:contents">
                <input type="hidden" name="draftId" value="<%= draft.id %>" />
                <button class="hhsrs-btn hhsrs-btn-primary hhsrs-rv-submit" type="submit">Submit</button>
              </form>
            </div>
            <form id="cancel-form" method="post" action="<%= hhsrsUrl('/cancel') %>">
              <input type="hidden" name="draftId" value="<%= draft.id %>" />
              <button class="hhsrs-rv-discard" type="submit">Cancel and discard this issue</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>
    document.getElementById("cancel-form").addEventListener("submit", function (e) {
      if (!confirm("Discard this issue and return to the start?")) e.preventDefault();
    });
  </script>
</body>
</html>
