<!DOCTYPE html>
<html lang="en-GB">
<head>
  <%- include("partials/head") %>
</head>
<body class="hhsrs-body hhsrs-form-page">
  <div class="stage">
    <div class="play-layout">
      <div class="work-panel">
        <header class="panel-top">
          <div class="hhsrs-logo"><%- include("../partials/logo") %></div>
          <div class="brand-text">
            <p class="eyebrow">Housing · Survey reporting</p>
            <strong>HHSRS Site Reporting</strong>
          </div>
        </header>
        <div class="panel-body">
          <h1>New issue</h1>
          <p class="hhsrs-lead">All fields marked * are required. Photos are required (at least <%= minPhotos %>, up to <%= maxPhotos %>).</p>
          <% const errList = Object.values(errors).filter(Boolean); %>
          <% if (formError || errList.length) { %>
            <div class="hhsrs-errors" role="alert">
              <p>Please fix the following:</p>
              <ul>
                <% if (formError) { %><li><%= formError %></li><% } %>
                <% errList.filter((e) => e !== formError).forEach((e) => { %>
                  <li><%= e %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
          <% const visitReady = steps.visit; %>
          <% const selectedProject = projects.find((p) => p.id === values.projectId); %>
          <% const flags = selectedProject ? selectedProject.flags : { calls: false, onward: false, saxon: false, online: false }; %>
          <% const addrOpen = !!(String(values.uprn || "").trim() && (String(values.fullAddress || "").trim() || values.addressConfirmed)); %>
          <form id="hhsrs-form" class="hhsrs-form" method="post" action="<%= hhsrsUrl('/review') %>" enctype="multipart/form-data" novalidate data-min-photos="<%= minPhotos %>" data-max-photos="<%= maxPhotos %>" data-max-file-bytes="<%= maxFileBytes %>" data-max-file-mb="<%= maxFileMb %>" data-stock-lookup="<%= hhsrsUrl('/stock-lookup') %>">
            <% if (draft) { %><input type="hidden" name="draftId" value="<%= draft.id %>" /><% } %>

            <div id="step-visit" class="info-box flow-step is-current" data-flow="visit">
              <p class="box-title">Project &amp; visit</p>
              <label for="projectId">Project *</label>
              <select id="projectId" name="projectId" required class="<%= errors.projectId ? 'is-invalid' : '' %>">
                <option value=""><%= projects.length ? "Select an active project" : "No active projects found" %></option>
                <% projects.forEach((p) => { %>
                  <option value="<%= p.id %>" <%= values.projectId === p.id ? "selected" : "" %><%= p.flags.calls ? " data-calls=\"1\"" : "" %><%= p.flags.saxon ? " data-saxon=\"1\"" : "" %><%= p.flags.online ? " data-online=\"1\"" : "" %>><%= p.name %></option>
                <% }) %>
              </select>
              <% if (errors.projectId) { %><p class="field-error"><%= errors.projectId %></p><% } %>

              <div class="field-row">
                <div>
                  <label for="surveyDate">Survey date *</label>
                  <input id="surveyDate" name="surveyDate" type="date" required value="<%= values.surveyDate %>" class="<%= errors.surveyDate ? 'is-invalid' : '' %>" />
                  <% if (errors.surveyDate) { %><p class="field-error"><%= errors.surveyDate %></p><% } %>
                </div>
                <div>
                  <label for="surveyorName">Surveyor *</label>
                  <select id="surveyorName" name="surveyorName" required class="<%= errors.surveyorName ? 'is-invalid' : '' %>">
                    <option value=""><%= surveyors.length ? "Select surveyor" : "No surveyors found" %></option>
                    <% surveyors.forEach((s) => { %>
                      <option value="<%= s.name %>" <%= values.surveyorName === s.name ? "selected" : "" %>><%= s.name %></option>
                    <% }) %>
                    <% if (values.surveyorName && !surveyors.some((s) => s.name === values.surveyorName)) { %>
                      <option value="<%= values.surveyorName %>" selected><%= values.surveyorName %></option>
                    <% } %>
                  </select>
                  <% if (errors.surveyorName) { %><p class="field-error"><%= errors.surveyorName %></p><% } %>
                </div>
              </div>
            </div>

            <p class="gate-hint" id="visit-gate-hint" <%= visitReady ? "hidden" : "" %>>Choose project, survey date and surveyor. On a phone or tablet, each next section opens when this one is complete.</p>

            <div id="issue-details" <%= visitReady ? "" : "hidden" %> class="form-rest">
              <div class="info-box flow-step" id="step-property" data-flow="property">
                <p class="box-title">Property</p>
                <p class="hhsrs-hint" style="margin-top:0">Enter the UPRN from this project’s stock list, then confirm the address. Edit it if it is wrong.</p>
                <div class="find-row">
                  <div>
                    <label for="uprn" style="margin-top:0">UPRN *</label>
                    <input id="uprn" name="uprn" type="text" required autocomplete="off" inputmode="numeric" placeholder="e.g. 100040123456" value="<%= values.uprn %>" class="<%= errors.uprn ? 'is-invalid' : '' %>" <%= addrOpen ? "readonly" : "" %> />
                  </div>
                  <button type="button" class="hhsrs-btn-find" id="btn-lookup-uprn" <%= addrOpen ? "disabled" : "" %>>Lookup</button>
                </div>
                <% if (errors.uprn) { %><p class="field-error"><%= errors.uprn %></p><% } %>
                <p class="find-status" id="find-status" aria-live="polite"></p>

                <div class="addr-card" id="addr-card" <%= addrOpen ? "" : "hidden" %>>
                  <label for="fullAddress" style="margin-top:0">Full address *</label>
                  <input id="fullAddress" name="fullAddress" type="text" required autocomplete="street-address" value="<%= values.fullAddress %>" class="<%= errors.fullAddress ? 'is-invalid' : '' %>" />
                  <% if (errors.fullAddress) { %><p class="field-error"><%= errors.fullAddress %></p><% } %>
                  <div class="field-row" style="margin-top:4px">
                    <div>
                      <label for="postcode">Postcode *</label>
                      <input id="postcode" name="postcode" type="text" required autocomplete="postal-code" value="<%= values.postcode %>" class="<%= errors.postcode ? 'is-invalid' : '' %>" />
                      <% if (errors.postcode) { %><p class="field-error"><%= errors.postcode %></p><% } %>
                    </div>
                  </div>
                  <p class="hhsrs-hint" id="addr-edit-hint">Wrong address? Edit it here, then tick confirm.</p>
                  <label class="confirm-row" id="confirm-row" for="addressConfirmed">
                    <input type="checkbox" id="addressConfirmed" name="addressConfirmed" value="true" <%= values.addressConfirmed ? "checked" : "" %> />
                    <span>Address is correct — I confirm this is the property</span>
                  </label>
                  <% if (errors.addressConfirmed) { %><p class="field-error"><%= errors.addressConfirmed %></p><% } %>
                  <button type="button" class="hhsrs-btn hhsrs-btn-change" id="btn-change-uprn">Change UPRN</button>
                </div>
              </div>

              <div class="info-box hazard flow-step" id="step-hazard" data-flow="hazard" <%= steps.property ? "" : "hidden" %>>
                <p class="box-title">Hazard</p>
                <div class="field-row">
                  <div>
                    <label for="category">HHSRS category *</label>
                    <select id="category" name="category" required class="<%= errors.category ? 'is-invalid' : '' %>">
                      <option value="">Select a category</option>
                      <% categories.forEach((c) => { %>
                        <option value="<%= c %>" <%= values.category === c ? "selected" : "" %>><%= c %></option>
                      <% }) %>
                    </select>
                    <% if (errors.category) { %><p class="field-error"><%= errors.category %></p><% } %>
                  </div>
                  <div>
                    <label for="rating">Rating *</label>
                    <select id="rating" name="rating" required class="<%= errors.rating ? 'is-invalid' : '' %>">
                      <option value="">Select a rating</option>
                      <% ratings.forEach((r) => { %>
                        <option value="<%= r %>" <%= values.rating === r ? "selected" : "" %>><%= r %></option>
                      <% }) %>
                    </select>
                    <% if (errors.rating) { %><p class="field-error"><%= errors.rating %></p><% } %>
                  </div>
                </div>

                <label for="comment">Comment *</label>
                <textarea id="comment" name="comment" required rows="5" placeholder="Describe the hazard in plain facts…" class="<%= errors.comment ? 'is-invalid' : '' %>"><%= values.comment %></textarea>
                <% if (errors.comment) { %><p class="field-error"><%= errors.comment %></p><% } %>
              </div>

              <div class="info-box flow-step" id="extra-box" data-flow="extras" <%= steps.hazard ? "" : "hidden" %>>
                <p class="box-title">Extra details <span id="extra-project-label" class="extra-project-label"><%= selectedProject ? "· " + selectedProject.name : "" %></span></p>
                <div class="project-extra" data-extra="calls" <%= flags.calls ? "" : "hidden" %>>
                  <label for="clientCallReference">Client call reference *</label>
                  <input id="clientCallReference" name="clientCallReference" type="text" placeholder="Call reference number" value="<%= values.clientCallReference %>" class="<%= errors.clientCallReference ? 'is-invalid' : '' %>" <%= flags.calls && !values.callUnreached ? "" : "disabled" %> />
                  <% if (errors.clientCallReference) { %><p class="field-error"><%= errors.clientCallReference %></p><% } %>
                  <label class="hhsrs-check" for="callUnreached">
                    <input id="callUnreached" name="callUnreached" type="checkbox" value="true" <%= values.callUnreached ? "checked" : "" %> <%= flags.calls ? "" : "disabled" %> />
                    <span>Couldn't get through — leave call reference blank</span>
                  </label>
                  <div id="call-ref-why" <%= values.callUnreached && flags.calls ? "" : "hidden" %>>
                    <label for="callRefBlankReason">Why the call reference is blank *</label>
                    <select id="callRefBlankReason" name="callRefBlankReason" class="<%= errors.callRefBlankReason ? 'is-invalid' : '' %>" <%= flags.calls && values.callUnreached ? "" : "disabled" %>>
                      <option value="">Select a reason</option>
                      <% callBlankReasons.forEach((reason) => { %>
                        <option value="<%= reason %>" <%= values.callRefBlankReason === reason ? "selected" : "" %>><%= reason %></option>
                      <% }) %>
                    </select>
                    <% if (errors.callRefBlankReason) { %><p class="field-error"><%= errors.callRefBlankReason %></p><% } %>
                    <label for="callUnreachedNote">Extra detail <span class="optional">(optional, unless Other)</span></label>
                    <textarea id="callUnreachedNote" name="callUnreachedNote" rows="2" placeholder="<%= values.callRefBlankReason === 'Other' ? 'Please say why…' : 'Add a short note if needed…' %>" class="<%= errors.callUnreachedNote ? 'is-invalid' : '' %>" <%= flags.calls && values.callUnreached ? "" : "disabled" %>><%= values.callUnreachedNote || "" %></textarea>
                    <% if (errors.callUnreachedNote) { %><p class="field-error"><%= errors.callUnreachedNote %></p><% } %>
                  </div>
                  <p class="hhsrs-hint">Required for this project. Enter the call reference, or pick why it is blank.</p>
                </div>
                <div class="project-extra" data-extra="saxon" <%= flags.saxon ? "" : "hidden" %>>
                  <p class="hhsrs-hint" id="saxon-damp-note">Saxon Weald: all damp and mould is phoned in. Email only if Severe, and include the call reference.</p>
                </div>
                <div class="project-extra" data-extra="online" <%= flags.online ? "" : "hidden" %>>
                  <p class="hhsrs-hint" id="cornwall-damp-note">Cornwall: any damp and mould needs Tom’s separate online form.</p>
                </div>

                <label for="otherDetails">Any other details <span class="optional">(optional)</span></label>
                <textarea id="otherDetails" name="otherDetails" rows="4" class="<%= errors.otherDetails ? 'is-invalid' : '' %>"><%= values.otherDetails %></textarea>
                <% if (errors.otherDetails) { %><p class="field-error"><%= errors.otherDetails %></p><% } %>
              </div>

              <div class="info-box flow-step" id="step-photos" data-flow="photos" <%= steps.extras ? "" : "hidden" %>>
                <fieldset class="hhsrs-photos">
                  <p class="box-title">Photos <span class="optional">(min <%= minPhotos %>, max <%= maxPhotos %>)</span></p>
                  <p class="hhsrs-hint"><%= photoHint %></p>
                  <p id="photo-status" class="find-status" aria-live="polite"></p>
                  <% if (errors.photos) { %><p class="field-error"><%= errors.photos %></p><% } %>
                  <div id="existing-photos" class="photo-grid">
                    <% if (draft && draft.photos.length) { %>
                      <% draft.photos.forEach((p) => { %>
                        <figure class="photo-card" data-existing>
                          <img src="<%= hhsrsUrl('/draft/' + draft.id + '/photo/' + encodeURIComponent(p.storedName)) %>" alt="<%= p.originalName %>" />
                          <figcaption><%= p.originalName %></figcaption>
                          <input type="hidden" name="keepPhotos" value="<%= p.storedName %>" />
                          <button type="button" class="hhsrs-btn hhsrs-btn-ghost photo-remove">Remove</button>
                        </figure>
                      <% }) %>
                    <% } %>
                  </div>
                  <div id="new-photos" class="photo-grid"></div>
                  <label class="hhsrs-file-btn" for="photos">Add photos</label>
                  <input id="photos" name="photos" type="file" accept="image/*" multiple />
                </fieldset>
              </div>

              <div class="actions" id="form-actions" <%= steps.extras ? "" : "hidden" %>>
                <button class="hhsrs-btn hhsrs-btn-primary" type="submit">Review</button>
                <button id="clear-form" class="hhsrs-btn hhsrs-btn-secondary" type="button">Clear Form</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script src="<%= hhsrsUrl('/assets/form.js') %>"></script>
</body>
</html>
