<!DOCTYPE html>
<html lang="en-GB">
<head>
  <%- include("partials/head") %>
</head>
<body class="hhsrs-body hhsrs-gate">
  <header class="hhsrs-top">
    <div class="hhsrs-logo"><%- include("../partials/logo") %></div>
    <p class="hhsrs-brand">HHSRS Site Reporting</p>
  </header>
  <main class="hhsrs-shell hhsrs-gate-shell">
    <h1>Enter access code</h1>
    <p class="hhsrs-lead">You only need to do this once on this phone.</p>
    <form class="hhsrs-gate-form" method="post" action="<%= hhsrsUrl('/access') %>" novalidate>
      <input type="hidden" name="next" value="<%= next %>" />
      <label class="gate-label" for="access-code">Access code</label>
      <input
        id="access-code"
        class="gate-input"
        name="code"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        maxlength="6"
        pattern="[0-9]{6}"
        enterkeyhint="go"
        required
        autofocus
      />
      <% if (error) { %>
        <p class="gate-error" role="alert"><%= error %></p>
      <% } %>
      <button class="hhsrs-btn hhsrs-btn-primary" type="submit">Continue</button>
    </form>
    <p class="gate-help">No code? Ask the HHSRS team.</p>
  </main>
  <script>
    (function () {
      var input = document.getElementById("access-code");
      if (!input) return;
      input.addEventListener("input", function () {
        var digits = String(input.value || "").replace(/\D/g, "").slice(0, 6);
        if (digits !== input.value) input.value = digits;
      });
    })();
  </script>
</body>
</html>
