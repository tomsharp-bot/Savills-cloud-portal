<%- include("partials/layout-open") %>
<%
  const blank = "—";
  const show = (value) => String(value || "").trim() || blank;
%>
<section class="vd-page" aria-label="View details">
  <a class="vd-back" href="<%= backHref %>">Back to Main Log</a>
  <div class="vd-bar">View details</div>
  <p class="vd-sub"><%= details.intro %></p>
  <div class="vd-pair">
    <div class="vd-col">
      <div class="vd-bar">Surveyor entry</div>
      <% if (details.surveyDate) { %><p class="vd-when">Survey date <%= details.surveyDate %></p><% } %>
      <div class="vd-box">
        <dl class="vd-fields">
          <div><dt>Project</dt><dd><%= show(details.projectName) %></dd></div>
          <div><dt>Address</dt><dd><%= show(details.address) %></dd></div>
          <div><dt>UPRN</dt><dd><%= show(details.uprn) %></dd></div>
          <div><dt>Survey date</dt><dd><%= show(details.surveyDate) %></dd></div>
          <div><dt>Surveyor</dt><dd><%= show(details.surveyorName) %></dd></div>
          <div><dt>Hazard</dt><dd><%= show(details.hazard) %></dd></div>
          <div><dt>Rating</dt><dd><%= show(details.rating) %></dd></div>
          <div><dt>Description</dt><dd><%= show(details.description) %></dd></div>
          <% (Array.isArray(surveyorLines) ? surveyorLines : []).forEach(function (line) { %>
            <div><dt><%= line.label %></dt><dd class="prewrap"><%= show(line.value) %></dd></div>
          <% }) %>
        </dl>
        <% if (details.photos && details.photos.length) { %>
          <div class="vd-shot">
            <% details.photos.forEach(function (photo) { %>
              <% if (photo.url) { %><span class="photo-thumb"><img src="<%= photo.url %>" alt="" width="96" height="72"></span><% } %>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
    <div class="vd-col">
      <div class="vd-bar">Email sent</div>
      <% if (details.sent) { %>
        <% if (details.sent.when) { %><p class="vd-when"><%= details.sent.when %></p><% } %>
        <article class="vd-email">
          <% if (details.sent.subject) { %><header class="vd-head"><%= details.sent.subject %></header><% } %>
          <div class="vd-sheet">
            <% if (details.sent.parties && details.sent.parties.length) { %>
              <div class="vd-parties">
                <% details.sent.parties.forEach(function (line) { %>
                  <div><span><%= line.label %></span> <%= line.value %></div>
                <% }) %>
              </div>
            <% } %>
            <div class="vd-copy"><%- details.sent.copyHtml %></div>
            <% if (details.sent.photos && details.sent.photos.length) { %>
              <div class="vd-shot">
                <% details.sent.photos.forEach(function (photo) { %>
                  <span class="photo-thumb"><img class="vd-photo" src="<%= photo.url %>" alt="" width="96" height="72"></span>
                <% }) %>
              </div>
            <% } %>
            <div class="vd-sign"><%- signatureHtml %></div>
          </div>
        </article>
      <% } else { %>
        <div class="vd-box"><p class="vd-sub">Not sent from the portal.</p></div>
      <% } %>
      <% (details.corrections || []).forEach(function (email) { %>
        <div class="vd-bar">Correction</div>
        <% if (email.when) { %><p class="vd-when"><%= email.when %></p><% } %>
        <article class="vd-email">
          <% if (email.subject) { %><header class="vd-head"><%= email.subject %></header><% } %>
          <div class="vd-sheet">
            <% if (email.parties && email.parties.length) { %>
              <div class="vd-parties">
                <% email.parties.forEach(function (line) { %>
                  <div><span><%= line.label %></span> <%= line.value %></div>
                <% }) %>
              </div>
            <% } %>
            <div class="vd-copy"><%- email.copyHtml %></div>
            <% if (email.photos && email.photos.length) { %>
              <div class="vd-shot">
                <% email.photos.forEach(function (photo) { %>
                  <span class="photo-thumb"><img class="vd-photo" src="<%= photo.url %>" alt="" width="96" height="72"></span>
                <% }) %>
              </div>
            <% } %>
            <div class="vd-sign"><%- signatureHtml %></div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<%- include("partials/layout-close") %>
