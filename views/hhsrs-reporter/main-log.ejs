<%- include("partials/layout-open") %>

<div class="page-header">
  <div>
    <h2 class="page-section-title">Main Log</h2>
    <p class="subtitle">Archive of dealt-with HHSRS cases — packs sent, notices filed, and office action complete.</p>
  </div>
  <div class="header-meta">
    <strong>Archive</strong>
    <%= summary.mainLog %> all-time
  </div>
</div>

<section class="actions-row">
  <a class="btn btn-ghost" href="<%= reporterBase %>">← Back to Pending Issues</a>
  <a class="btn btn-primary" href="<%= reporterBase %>/review">Go to Review and create</a>
</section>

<section class="panel" aria-label="Main Log archive">
  <div class="panel-head review-head">
    <h2>Main Log archive</h2>
    <span class="count count-review"><%= rows.length %> shown · <%= summary.mainLog %> total</span>
  </div>
  <form class="filter-bar" method="get" action="<%= reporterBase %>/main-log">
    <input type="search" name="q" value="<%= filters.q %>" placeholder="Search address, UPRN, project…" aria-label="Search main log" />
    <select name="project" aria-label="Filter by project">
      <option value="">All projects</option>
      <% projectNames.forEach((name) => { %>
        <option value="<%= name %>" <%= filters.project === name ? "selected" : "" %>><%= name %></option>
      <% }) %>
    </select>
    <select name="rating" aria-label="Filter by rating">
      <option value="">All ratings</option>
      <% ratings.forEach((r) => { %>
        <option value="<%= r %>" <%= filters.rating === r ? "selected" : "" %>><%= r %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-ghost btn-sm">Apply</button>
  </form>
  <% if (!rows.length) { %>
    <p class="empty" style="padding:1rem 1.1rem;">No actioned cases yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="landing-table">
        <thead>
          <tr>
            <th>Project</th>
            <th>Address</th>
            <th>UPRN</th>
            <th>Category</th>
            <th>Rating</th>
            <th>Actioned</th>
            <th>By</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((row) => {
            const when = row.emailSentAt || row.updatedAt;
            const pillClass = row.status === "email_sent" ? "sent" : (row.status === "closed" ? "closed" : "ready");
          %>
            <tr>
              <td><span class="project-pill"><%= row.projectName %></span></td>
              <td><strong><%= row.fullAddress %></strong></td>
              <td><%= row.uprn %></td>
              <td><%= row.category %></td>
              <td class="<%= ratingDisplayClass(row.rating) %>"><%= row.rating %></td>
              <td><%= formatDocDate(when) %></td>
              <td><%= row.emailSentBy || row.lastEditedBy || "—" %></td>
              <td><span class="status-pill <%= pillClass %>"><%= actionedStatusLabel(row.status) %></span></td>
              <td>
                <a class="linkish dark" href="<%= reporterBase %>/main-log/<%= row.id %>">View entry</a>
                <a class="linkish dark" href="<%= reporterBase %>/review/<%= row.id %>">View pack →</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <div class="table-foot">
    <span>Full archive · Filters apply to actioned cases</span>
    <a class="btn btn-ghost btn-sm" href="<%= reporterBase %>/main-log/export.csv">Export CSV</a>
  </div>
</section>

<p class="footer-note">Main Log archive · Live actioned submissions</p>

<% if (typeof entry !== "undefined" && entry) { %>
<div class="ml-overlay" id="ml-overlay">
  <div class="ml-dialog" role="dialog" aria-modal="true" aria-labelledby="ml-title">
    <div class="ml-head">
      <h2 id="ml-title">Main Log entry</h2>
      <span class="count count-dealt">Actioned</span>
    </div>
    <% if (entry.copyWarning) { %><p class="ml-sub"><%= entry.copyWarning %></p><% } %>
    <div class="ml-body" id="ml-body">
      <dl class="ml-list">
        <dt>Case</dt><dd><%= entry.caseLine %></dd>
        <dt>Email</dt><dd class="<%= entry.emailSent ? '' : 'ml-empty' %>"><% if (entry.emailSent) { %><strong><%= entry.emailLine %></strong><% } else { %><%= entry.emailLine %><% } %></dd>
        <dt>From</dt><dd><%= entry.fromLine %></dd>
        <dt>Marked actioned by</dt><dd><%= entry.markedByLine %></dd>
        <div class="ml-sep"></div>
        <dt>To</dt><dd class="<%= entry.to ? '' : 'ml-empty' %>"><%= entry.to || "—" %></dd>
        <dt>Cc</dt><dd class="<%= entry.cc ? '' : 'ml-empty' %>"><%= entry.cc || "—" %></dd>
        <dt>Bcc</dt><dd class="<%= entry.bcc ? '' : 'ml-empty' %>"><%= entry.bcc || "—" %></dd>
        <dt>Subject</dt><dd class="<%= entry.subject ? '' : 'ml-empty' %>"><%= entry.subject || "—" %></dd>
      </dl>
      <details class="ml-text" open>
        <summary>Email text</summary>
        <pre><%= entry.body || "(empty)" %></pre>
      </details>
      <p class="ml-photos-label"><%= entry.photoLabel %></p>
      <% if (entryPhotos && entryPhotos.length) { %>
        <div class="ml-photos">
          <% entryPhotos.forEach((p) => { %>
            <figure>
              <img src="<%= p.url %>" alt="<%= p.caption %>" />
              <figcaption><%= p.name %></figcaption>
            </figure>
          <% }) %>
        </div>
      <% } else if (entry.photoNames.length) { %>
        <ul class="ml-photos-names">
          <% entry.photoNames.forEach((name) => { %><li><%= name %></li><% }) %>
        </ul>
      <% } else { %>
        <p class="ml-note" style="font-style:normal;margin-top:0.3rem">No photos.</p>
      <% } %>
    </div>
    <div class="ml-foot"><a class="btn btn-primary" id="ml-close" href="<%= reporterBase %>/main-log">Close</a></div>
  </div>
</div>
<% } %>

<%- include("partials/layout-close") %>
