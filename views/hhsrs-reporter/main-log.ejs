<%- include("partials/layout-open") %>
<%
  const logRows = rows.map((row) => {
    const emailed = Array.isArray(row.photoNames) ? row.photoNames.filter((name) => String(name || "").trim()) : [];
    const stored = Array.isArray(row.photoPaths) ? row.photoPaths : [];
    return {
      id: row.submissionId,
      reference: row.reference,
      projectName: row.projectName,
      fullAddress: row.fullAddress,
      photoPaths: emailed.length ? emailed : stored,
      uprn: row.uprn,
      surveyorName: row.surveyorName,
      category: row.hazard,
      rating: row.rating,
      createdAt: row.createdAt,
      addressLine: row.addressLine,
      actionedOn: row.whenDate,
      actionedBy: row.sentBy,
      href: row.href,
      rowClass: row.selected ? "is-sel" : "",
      amendedNote: row.correctedNote ? "Amended" : "",
      rowNote: row.kind === "dismissed" ? (row.logLine || "") : ""
    };
  });
%>

<div class="ml-page">
  <div class="ml-headbar">
    <h1>Main Log</h1>
    <p>Every email sent from <%= mailbox %></p>
  </div>

  <div class="ml-card">
    <form class="ml-filters" id="ml-filters" method="get" action="<%= reporterBase %>/main-log">
      <input type="hidden" name="type" value="<%= filters.type %>" />
      <% if (filters.sort) { %>
        <input type="hidden" name="sort" value="<%= filters.sort %>" />
        <input type="hidden" name="dir" value="<%= filters.dir === "desc" ? "desc" : "asc" %>" />
      <% } %>
      <div class="ml-f ml-search">
        <label for="ml-q">Search</label>
        <input id="ml-q" name="q" type="search" value="<%= filters.q %>" placeholder="Reference, UPRN or address" autocomplete="off" />
      </div>
      <div class="ml-f">
        <label for="ml-project">Project</label>
        <select id="ml-project" name="project">
          <option value="">All projects</option>
          <% projectNames.forEach((name) => { %>
            <option value="<%= name %>" <%= filters.project === name ? "selected" : "" %>><%= name %></option>
          <% }) %>
        </select>
      </div>
      <div class="ml-f">
        <label for="ml-by">Sent by</label>
        <select id="ml-by" name="by">
          <option value="">Anyone</option>
          <% senders.forEach((name) => { %>
            <option value="<%= name %>" <%= filters.by === name ? "selected" : "" %>><%= name %></option>
          <% }) %>
        </select>
      </div>
      <div class="ml-f ml-f-type">
        <label>Type</label>
        <div class="ml-seg">
          <% const types = [
            { value: "", label: "All" },
            { value: "original", label: "Original" },
            { value: "correction", label: "Correction" },
            { value: "not_sent", label: "Not sent from portal" }
          ]; %>
          <% types.forEach((item) => {
            const params = new URLSearchParams();
            if (filters.q) params.set("q", filters.q);
            if (filters.project) params.set("project", filters.project);
            if (filters.by) params.set("by", filters.by);
            if (item.value) params.set("type", item.value);
            if (filters.from) params.set("from", filters.from);
            if (filters.to) params.set("to", filters.to);
            if (filters.sort) {
              params.set("sort", filters.sort);
              params.set("dir", filters.dir === "desc" ? "desc" : "asc");
            }
            const href = reporterBase + "/main-log" + (params.toString() ? "?" + params.toString() : "");
            const on = filters.type === item.value;
          %>
            <a class="<%= on ? "on" : "" %> <%= on && item.value === "correction" ? "corr" : "" %>" href="<%= href %>"><%= item.label %></a>
          <% }) %>
        </div>
      </div>
      <div class="ml-f">
        <label for="ml-from">From</label>
        <input id="ml-from" name="from" type="date" data-date-search value="<%= filters.from %>" />
      </div>
      <div class="ml-f">
        <label for="ml-to">To</label>
        <input id="ml-to" name="to" type="date" data-date-search value="<%= filters.to %>" />
      </div>
      <button type="submit" class="ml-submit">Search</button>
    </form>
    <div class="ml-bar">
      <div class="ml-count"><%= showing %><% if (ofTotal) { %><span>of <%= ofTotal %></span><% } %></div>
      <div class="ml-bar-actions">
        <a class="btn ml-clear" href="<%= clearHref %>">Clear</a>
        <a class="btn ml-excel" href="<%= exportHref %>"><span class="ml-x" aria-hidden="true">X</span>Export to Excel</a>
      </div>
    </div>
  </div>

  <section class="panel" aria-label="Main Log">
    <div class="panel-head">
      <h2>Main Log</h2>
      <span class="count"><%= showing %><% if (ofTotal) { %> of <%= ofTotal %><% } %></span>
    </div>
    <% if (!rows.length) { %>
      <p class="empty" style="padding:1rem 1.1rem;">No emails match. Try clearing the filters.</p>
    <% } else { %>
      <%- include("partials/pending-issues-table", {
        pendingRows: logRows,
        pendingTableId: "main-log-table",
        pendingFoot: filters.sort ? "" : "Newest first",
        pendingShowPhotoCount: true,
        pendingShowActioned: true,
        pendingAddressFirstLine: true,
        pendingAction: "details",
        pendingSortColumns: sortColumns
      }) %>
    <% } %>
    <% if (pageCount > 1) { %>
      <div class="ml-pager">
        <% if (prevHref) { %><a href="<%= prevHref %>">Previous</a><% } %>
        <span>Page <%= page %> of <%= pageCount %></span>
        <% if (nextHref) { %><a href="<%= nextHref %>">Next</a><% } %>
      </div>
    <% } %>
  </section>
</div>

<% if (panel) { %>
<div class="ml-scrim on" id="ml-scrim"></div>
<aside class="ml-drawer on" id="ml-drawer" role="dialog" aria-modal="true" aria-label="Email details">
  <div class="ml-d-head">
    <% if (panel.reference) { %><span class="ref-chip ref-chip-lg"><%= panel.reference %></span><% } %>
    <span class="ml-tag <%= panel.kind === "correction" ? "c" : (panel.kind === "not_sent" ? "n" : "o") %>"><%= panel.typeLabel %></span>
    <span class="ml-d-title"><%= panel.projectName %></span>
    <a class="ml-x" id="ml-close" href="<%= panel.closeHref %>" aria-label="Close">×</a>
  </div>
  <div class="ml-d-body">
    <p class="ml-d-case"><%= panel.fullAddress || "—" %></p>
    <p class="ml-d-sub">UPRN <%= panel.uprn || "—" %> · <%= panel.hazard || "—" %> · <span class="<%= panel.ratingClass %>"><%= panel.rating || "—" %></span></p>
    <% if (panel.kind === "correction" && panel.originalWhen) { %>
      <div class="ml-corrbox">
        <b>Correction of email sent <%= panel.originalWhen %></b>
        Reason: <%= panel.correctionReason || "—" %><% if (panel.correctionNote) { %> · Note: <%= panel.correctionNote %><% } %>
        <% if (panel.originalHref) { %><br /><a href="<%= panel.originalHref %>">View original email →</a><% } %>
      </div>
    <% } %>
    <% if (panel.kind !== "correction" && panel.corrections && panel.corrections.length) { %>
      <div class="ml-origbox">
        <% panel.corrections.forEach((item) => { %>
          <div>Corrected on <%= item.when %><% if (item.reason) { %> (<%= item.reason %>)<% } %> · <a href="<%= item.href %>">View correction →</a></div>
        <% }) %>
      </div>
    <% } %>
    <% if (panel.kind === "dismissed") { %>
      <div class="ml-origbox"><%= panel.logLine %></div>
    <% } else if (panel.kind === "not_sent") { %>
      <div class="ml-origbox">Not sent from the portal. Marked actioned on <%= panel.when %>.</div>
    <% } %>
    <div class="ml-facts">
      <div><span><%= panel.kind === "dismissed" ? "Viewed by" : "Sent by" %></span><b><%= panel.sentBy || "—" %></b></div>
      <div><span><%= panel.kind === "dismissed" ? "Viewed" : "Sent" %></span><b><%= panel.when %></b></div>
      <div><span>Photos</span><b><%= panel.photoCount %></b></div>
    </div>
    <dl class="ml-meta">
      <dt>From</dt><dd class="<%= panel.from ? "" : "none" %>"><%= panel.from || "—" %></dd>
      <dt>To</dt><dd class="<%= panel.to ? "" : "none" %>"><%= panel.to || "—" %></dd>
      <dt>Cc</dt><dd class="<%= panel.cc ? "" : "none" %>"><%= panel.cc || "—" %></dd>
      <dt>Bcc</dt><dd class="<%= panel.bcc ? "" : "none" %>"><%= panel.bcc || "—" %></dd>
      <dt>Subject</dt><dd class="<%= panel.subject ? "" : "none" %>"><% if (panel.subject) { %><b><%= panel.subject %></b><% } else { %>—<% } %></dd>
    </dl>
    <% if (panel.kind !== "not_sent" && panel.kind !== "dismissed") { %>
      <%- include("partials/sent-email-card", {
        cardLabel: "Email that was sent",
        card: {
          subject: panel.subject,
          bodyHtml: panel.bodyHtml,
          signatureHtml: typeof signatureHtml !== "undefined" ? signatureHtml : "",
          photos: panel.photos.map((photo) => ({ url: photo.url, name: photo.name, caption: photo.name }))
        }
      }) %>
    <% } %>
  </div>
  <div class="ml-d-foot">
    <a class="btn btn-primary" href="<%= panel.caseHref %>">Open case</a>
    <a class="btn ml-pack" href="<%= panel.caseHref %>">View pack</a>
    <% if (panel.originalHref) { %><a class="btn ml-pack" href="<%= panel.originalHref %>">View original</a><% } %>
    <a class="btn ml-pack ml-close-link" href="<%= panel.closeHref %>">Close</a>
  </div>
</aside>
<% } %>

<div id="ml-photo-full" class="ml-photo-full" hidden>
  <img alt="" />
</div>

<script src="<%= mainLogJsUrl %>"></script>
<%- include("partials/layout-close") %>
