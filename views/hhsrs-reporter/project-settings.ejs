<%- include("partials/layout-open") %>

<div class="page-header">
  <div>
    <h2 class="page-section-title">Project settings</h2>
    <p class="subtitle">Archived projects stay on file. Reinstate puts one back to current so surveyors see it on the site form again.</p>
  </div>
  <div class="header-meta">
    <strong>Project settings</strong>
    <%= archivedProjects.length %> archived
  </div>
</div>

<h2 class="page-section-title section-bar" id="archived-projects">
  <span class="section-bar-label">Archived projects</span>
  <span class="count count-review"><%= archivedProjects.length %></span>
</h2>
<section class="panel" aria-label="Archived projects">
  <% if (!archivedProjects.length) { %>
    <p class="ps-empty">No archived projects.</p>
  <% } else { %>
    <ul class="ps-archived-list">
      <% archivedProjects.forEach(function (project) { %>
        <li>
          <div>
            <p class="ps-archived-name"><%= project.name %></p>
            <p class="ps-archived-meta"><%= project.projectManager %></p>
          </div>
          <form method="post" action="<%= reporterBase %>/project-settings/reinstate">
            <input type="hidden" name="projectId" value="<%= project.id %>" />
            <button type="submit" class="btn btn-primary btn-sm">Reinstate</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<p class="footer-note">Project settings · Reinstate does not delete anything</p>

<%- include("partials/layout-close") %>
