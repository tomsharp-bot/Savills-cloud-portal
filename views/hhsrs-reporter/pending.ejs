<%- include("partials/layout-open") %>

<h2 class="page-section-title">Pending Issues</h2>

<div class="landing-toolbar" aria-label="Quick tools">
  <a class="linkish dark" href="#last-actioned" style="margin-left:auto;font-size:0.75rem;">Jump to last 20 actioned</a>
</div>

<section class="panel waiting-urgent" id="not-actioned" aria-label="Pending issues">
  <div class="panel-head received-head">
    <h2><span class="urgent-icon" aria-hidden="true">!</span> Pending issues</h2>
    <span class="count count-received"><%= waitingRows.length %> need action</span>
  </div>
  <div class="panel-body-alerts">
    <%- include("partials/desktop-alerts-control") %>
  </div>
  <div class="waiting-banner">
    <span class="badge-need">Urgent</span>
    <span>These hazards are waiting — review and create packs before they age further.</span>
  </div>
  <% if (!waitingRows.length) { %>
    <p class="empty" style="padding:1rem 1.1rem;">No pending site-form submissions. New cases from the surveyor form appear here.</p>
  <% } else { %>
    <%- include("partials/pending-issues-table", { pendingRows: waitingRows, pendingTableId: "waiting-table" }) %>
  <% } %>
</section>

<section class="panel" id="last-actioned" aria-label="Last 20 issues that have been actioned" style="margin-top:1.25rem;">
  <div class="panel-head dealt-head">
    <h2>Last 20 issues that have been actioned</h2>
    <span class="count count-dealt"><%= actionedRows.length %> shown</span>
  </div>
  <% if (!actionedRows.length) { %>
    <p class="empty" style="padding:1rem 1.1rem;">Nothing actioned yet. Cases move to Main Log when you press Send and log.</p>
  <% } else { %>
    <%- include("partials/pending-issues-table", {
      pendingRows: actionedRows,
      pendingTableId: "last-actioned-table",
      pendingFoot: 'Most recently actioned first · Full history in <a class="linkish dark" href="' + reporterBase + '/main-log">Main Log</a>'
    }) %>
  <% } %>
</section>

<p class="footer-note">HHSRS Reporter · Pending Issues · Live site-form queue · en-GB</p>

<%- include("partials/layout-close") %>
