<%- include("partials/layout-open") %>
<%
  const isFilled = mode === "filled" && row;
  const projectValue = typeof reviewProjectValue === "string"
    ? reviewProjectValue
    : (isFilled ? row.projectName : "");
  const projectNames = Array.isArray(reviewProjectNames) ? reviewProjectNames : [];
  const casePhotos = Array.isArray(photos) ? photos : [];
  const claimState = typeof claim !== "undefined" && claim ? claim : null;
  const showAbandon = !!(claimState && (claimState.status === "claimed" || claimState.status === "stale"));
  const caseWaiting = isFilled && (row.status === "new" || row.status === "in_review" || row.status === "email_ready");
  const showNotNeeded = caseWaiting && !sentEmail;
  const caseNotNeeded = isFilled && row.status === "not_needed";
%>

<div class="page-header">
  <div>
    <h2 class="page-section-title">Review &amp; Create<% if (isFilled && row.reference) { %> <span class="ref-chip"><%= row.reference %></span><% } %></h2>
    <% if (isFilled) { %>
      <p class="subtitle" id="review-subtitle">Review the site submission for <%= row.projectName %>, then send the client email.</p>
    <% } else { %>
      <p class="subtitle" id="review-subtitle" hidden></p>
    <% } %>
  </div>
  <span class="review-mode-badge <%= isFilled ? 'is-filled' : '' %>" id="review-mode-badge"><%= isFilled ? "From queue" : "New case" %></span>
</div>

<section class="actions-row">
  <a class="btn btn-ghost" href="<%= reporterBase %>">← Back to Pending Issues</a>
  <% if (isFilled) { %>
    <%- include("partials/claim-chip", { claimRow: claimState }) %>
    <form method="post" action="<%= reporterBase %>/review/<%= row.id %>/abandon" id="abandon-claim-form">
      <button type="submit" class="btn btn-abandon-claim" id="btn-abandon-claim" <%= showAbandon ? "" : "hidden" %>>Abandon claim — return to pending</button>
    </form>
  <% } %>
  <a class="btn btn-create-email" id="btn-create-plain-email" href="<%= reporterBase %>/review?compose=1">Create new email</a>
</section>

<div id="review-workspace">
  <section class="panel waiting-urgent rv-pending-strip <%= alsoWaiting.length ? '' : 'is-clear' %>" id="rv-also-waiting" aria-label="Other Pending Issues">
    <details id="rv-also-details">
      <summary class="panel-head received-head rv-pending-summary">
        <div class="rv-pending-summary-left">
          <span class="rv-pending-chevron" aria-hidden="true">▶</span>
          <h2><span class="urgent-icon" aria-hidden="true">!</span> Other Pending Issues</h2>
        </div>
        <span class="count count-received"><%= alsoWaiting.length %> <%= alsoWaiting.length === 1 ? "waiting" : "waiting" %></span>
      </summary>
      <% if (!alsoWaiting.length) { %>
        <p class="waiting-empty-msg" id="rv-also-empty">No other pending issues — you’re up to date.</p>
      <% } else { %>
        <%- include("partials/pending-issues-table", { pendingRows: alsoWaiting, pendingTableId: "rv-also-table", pendingWrapId: "rv-also-table-wrap" }) %>
      <% } %>
    </details>
  </section>

  <section class="panel review-project-first" id="rv-project-block" aria-label="Project">
    <div class="panel-head review-head">
      <h2>Project</h2>
    </div>
    <div class="review-project-body">
      <label for="rv-project">Project</label>
      <select id="rv-project" name="projectNameDisplay" aria-describedby="rv-project-hint" <%= sentEmail ? "disabled" : "" %>>
        <option value="">Select a project…</option>
        <% projectNames.forEach((name) => { %>
          <option value="<%= name %>" <%= projectValue === name ? "selected" : "" %>><%= name %></option>
        <% }) %>
      </select>
      <p class="review-project-hint" id="rv-project-hint">Choose the project first. Extra fields and the email draft follow its rules.</p>
    </div>
  </section>

  <div class="review-grid">
    <section class="panel panel-overflow-visible<%= sentEmail ? ' is-sent-case' : '' %>" id="rv-case-panel" aria-label="Case Details">
      <% if (isFilled) { %>
      <form method="post" action="<%= reporterBase %>/review/<%= row.id %>" id="rv-save-form">
        <input type="hidden" name="expectedUpdatedAt" value="<%= row.updatedAt.toISOString() %>" />
        <input type="hidden" name="status" value="<%= row.status === 'new' ? 'in_review' : row.status %>" />
      <% } %>
      <div class="panel-head review-head">
        <h2 id="rv-case-heading">Case Details<% if (isFilled && row.reference) { %> <span class="ref-chip"><%= row.reference %></span><% } %></h2>
        <span class="count count-review" id="rv-case-badge"><%= isFilled ? "Case" : "Blank" %></span>
      </div>
      <div class="blank-case-form" id="rv-case-form">
        <fieldset class="case-fields" id="rv-case-fields" <%= sentEmail || (!isFilled && !projectValue) ? "disabled" : "" %>>
          <div class="field-row">
            <div>
              <label for="rv-uprn">UPRN</label>
              <input id="rv-uprn" name="uprnDisplay" type="text" value="<%= isFilled ? row.uprn : '' %>" <%= isFilled ? "readonly" : "" %> placeholder="UPRN" autocomplete="off" />
            </div>
            <div>
              <label for="rv-surveyor">Surveyor</label>
              <input id="rv-surveyor" type="text" value="<%= isFilled ? row.surveyorName : '' %>" <%= isFilled ? "readonly" : "" %> placeholder="Surveyor name" autocomplete="off" />
            </div>
          </div>
          <div>
            <label for="rv-address">Address</label>
            <input id="rv-address" type="text" value="<%= isFilled ? (row.fullAddress + (row.postcode ? ', ' + row.postcode : '')) : '' %>" <%= isFilled ? "readonly" : "" %> placeholder="Flat / house address" autocomplete="off" />
            <% if (isFilled && row.addressSource === "manual") { %>
              <p class="address-typed-note" id="address-typed-note">Address typed by surveyor</p>
            <% } %>
          </div>
          <div class="field-row">
            <div>
              <label for="rv-hazard">Hazard / category</label>
              <% if (isFilled) { %>
                <input id="rv-hazard" type="text" value="<%= row.category %>" readonly />
              <% } else { %>
                <input id="rv-hazard" type="text" placeholder="e.g. Electrical Hazards" autocomplete="off" list="hazard-list" />
                <datalist id="hazard-list">
                  <% categories.forEach((c) => { %><option value="<%= c %>"></option><% }) %>
                </datalist>
              <% } %>
            </div>
            <div>
              <label for="rv-rating">Rating</label>
              <select id="rv-rating" name="rating" <%= isFilled ? "required" : "" %>>
                <option value="">Select…</option>
                <%
                  const ratingList = (matchedProject && ratingOptions[matchedProject.ratingScheme]) || ratings;
                  const currentRating = isFilled ? row.rating : "";
                  const opts = Array.from(new Set([...(ratingList || []), currentRating].filter(Boolean)));
                  opts.forEach((r) => {
                %>
                  <option value="<%= r %>" <%= currentRating === r ? "selected" : "" %>><%= r %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div>
            <label for="rv-notes">Site notes / short description</label>
            <textarea id="rv-notes" name="clientDescription" placeholder="Concise fault and location…"><%= isFilled ? (row.clientDescription || row.comment) : "" %></textarea>
            <% if (isFilled && row.comment && row.clientDescription) { %>
              <p class="review-project-hint">Surveyor comment (source): <%= row.comment %></p>
            <% } %>
          </div>

          <div class="project-extra" data-extra="calls" hidden>
            <% const storedCallRef = isFilled ? String(row.clientCallReference || "").trim() : ""; %>
            <div>
              <label for="rv-call-ref">Client call reference</label>
              <input id="rv-call-ref" name="clientCallReference" type="text" value="<%= storedCallRef %>" placeholder="Call reference number" autocomplete="off" />
            </div>
            <div id="rv-call-blank" <%= storedCallRef ? "hidden" : "" %>>
              <label for="rv-call-reason">Why the call reference is blank</label>
              <select id="rv-call-reason" name="callRefBlankReason">
                <option value="">Select a reason</option>
                <% (callBlankReasons || []).forEach((reason) => { %>
                  <option value="<%= reason %>" <%= isFilled && callBlank.reason === reason ? "selected" : "" %>><%= reason %></option>
                <% }) %>
              </select>
              <label for="rv-call-notes">Extra detail <span class="optional">(optional, unless Other)</span></label>
              <input id="rv-call-notes" name="callNotes" type="text" value="<%= isFilled ? (callBlank.note || '') : '' %>" placeholder="Add a short note if needed…" autocomplete="off" />
            </div>
          </div>

          <div class="project-extra" data-extra="survey_date" hidden>
            <label for="rv-survey-date">Survey date</label>
            <input id="rv-survey-date" type="<%= isFilled ? 'text' : 'date' %>" value="<%= isFilled ? row.surveyDate : '' %>" <%= isFilled ? "readonly" : "" %> />
          </div>

          <div class="project-extra" data-extra="onward" hidden>
            <div class="field-row">
              <div>
                <label for="rv-onward-topic">Onward subject hazard</label>
                <select id="rv-onward-topic" name="onwardTopic">
                  <option value="">Select…</option>
                  <% onwardTopics.forEach((t) => { %>
                    <option value="<%= t %>" <%= isFilled && row.onwardTopic === t ? "selected" : "" %>><%= t %></option>
                  <% }) %>
                </select>
              </div>
              <div class="check-row" style="margin-top:1.55rem">
                <input id="rv-cat1" name="cat1Confirmed" type="checkbox" value="true" <%= isFilled && row.cat1Confirmed ? "checked" : "" %> />
                <label for="rv-cat1" style="text-transform:none;letter-spacing:0;font-weight:600;color:var(--text)">Category 1 confirmed (for CAT1 subject)</label>
              </div>
            </div>
          </div>

          <div class="project-extra" data-extra="cause">
            <label for="rv-cause">Suspected cause · if reported</label>
            <input id="rv-cause" name="suspectedCause" type="text" value="<%= isFilled ? row.suspectedCause : '' %>" placeholder="Only if the surveyor reported a cause" autocomplete="off" />
            <div class="check-row">
              <input type="hidden" name="includeCause" value="false" />
              <input id="rv-include-cause" name="includeCause" type="checkbox" value="true" <%= !isFilled || row.includeCause ? "checked" : "" %> />
              <label for="rv-include-cause" style="text-transform:none;letter-spacing:0;font-weight:600;color:var(--text)">Include cause in client email</label>
            </div>
          </div>

          <div class="project-extra" data-extra="vulnerabilities" hidden>
            <label for="rv-vulnerabilities">Resident vulnerabilities · only details reported</label>
            <textarea id="rv-vulnerabilities" name="vulnerabilities" style="min-height:72px" placeholder="Enter relevant resident details from the email, if any."><%= isFilled ? row.vulnerabilities : "" %></textarea>
            <div class="check-row">
              <input id="rv-include-vuln" type="checkbox" />
              <label for="rv-include-vuln" style="text-transform:none;letter-spacing:0;font-weight:600;color:var(--text)">Include in client email</label>
              <span id="rv-vuln-rule" class="review-project-hint" style="margin:0"></span>
            </div>
          </div>

          <div class="project-extra" data-extra="work_order" hidden>
            <label for="rv-work-order">Work order number</label>
            <input id="rv-work-order" name="workOrder" type="text" value="<%= isFilled ? row.workOrder : '' %>" placeholder="e.g. WO 0309445" autocomplete="off" />
          </div>

          <div class="project-extra" data-extra="online_form" hidden>
            <p class="cornwall-form-note" id="rv-online-form-note">
              <strong>Cornwall online form:</strong> for damp / mould, Tom’s separate online form may still be required after this email. Track that action until completed.
            </p>
            <label for="rv-online-action">Online form action</label>
            <input id="rv-online-action" type="text" placeholder="e.g. Separate damp and mould online form" autocomplete="off" />
          </div>

          <% if (isFilled) { %>
            <label for="rv-internal-notes">Internal notes</label>
            <textarea id="rv-internal-notes" name="internalNotes" style="min-height:72px"><%= row.internalNotes %></textarea>
          <% } %>

          <div class="photos-block <%= isFilled ? '' : 'is-blank-mode' %>" id="rv-photos-block">
            <div class="photos-head">
              <label>Photos <span class="photos-sub" id="rv-photos-sub">(up to 4)</span></label>
              <span class="photos-count" id="rv-photos-count" aria-live="polite"><%= casePhotos.length %> / 4</span>
            </div>
            <div class="photo-thumbs case-photo-thumbs" id="rv-photo-thumbs" aria-label="Case photos">
              <% casePhotos.forEach((p) => { %>
                <div class="photo-thumb photo-zoom case-photo-thumb" data-photo-id="<%= p.id %>">
                  <img src="<%= p.url %>" alt="<%= p.caption %>" draggable="false" />
                  <span class="photo-caption"><%= p.caption %></span>
                </div>
              <% }) %>
            </div>
            <div class="photos-add-row" id="rv-photos-add-row" <%= isFilled ? "hidden" : "" %>>
              <label class="photos-dropzone" id="rv-photos-dropzone" for="rv-photo-file">
                <span>Add photo</span>
                <span class="photos-drop-hint">Drop an image here, or browse (up to 4)</span>
              </label>
              <input type="file" id="rv-photo-file" accept="image/*" hidden multiple />
            </div>
          </div>
        </fieldset>
        <div class="generate-email-row">
          <button type="button" class="btn btn-primary" id="btn-generate-email" <%= isFilled && !sentEmail ? "" : "disabled" %>>Generate email</button>
          <button type="button" class="btn btn-ghost" id="btn-amend-case" hidden>Amend case details</button>
          <% if (isFilled) { %>
            <button type="submit" class="btn btn-ghost" <%= sentEmail ? "disabled" : "" %>>Save review</button>
          <% } %>
          <span class="review-project-hint" id="rv-generate-note">Choose a project, complete the case details, then generate the email.</span>
        </div>
      </div>
      <% if (isFilled) { %></form><% } %>
    </section>

    <section class="panel email-draft-panel<%= sentEmail ? ' is-sent-lock' : '' %>" aria-label="Client Email Draft">
      <div class="panel-head neutral">
        <h2>Client Email Draft</h2>
        <span class="count <%= sentEmail ? 'count-dealt' : 'count-review' %>" id="rv-email-badge"><%= sentEmail ? "Sent" : "Draft" %></span>
      </div>
      <p class="review-draft-status" id="rv-draft-status" hidden></p>
      <% if (draftError) { %><p class="flash flash-err"><%= draftError %></p><% } %>
      <form class="email-form <%= sentEmail ? 'is-sent' : '' %>" id="rv-email-form" autocomplete="off" onsubmit="return false;">
        <% if (sentEmail) { %>
          <p class="sent-banner" id="rv-sent-banner" role="status" aria-live="polite"><%= sentBanner %></p>
          <% if (!sentEmail.sentCopySaved) { %><p class="send-warn" id="rv-sent-copy-warn">Sent. Mailbox Sent folder copy failed.</p><% } %>
        <% } else { %>
          <p class="sent-banner" id="rv-sent-banner" role="status" aria-live="polite" hidden></p>
        <% } %>
        <div class="field-locked">
          <label id="rv-email-from-label">From</label>
          <div class="locked-field" id="rv-email-from" aria-labelledby="rv-email-from-label" aria-readonly="true"><span class="lock" aria-hidden="true">🔒</span><%= sendConfig.fromLine %><span class="locked-tag">Locked</span></div>
        </div>
        <div class="field-with-copy">
          <label for="hhsrs-to">To</label>
          <input id="hhsrs-to" name="hhsrs-to" type="text" inputmode="email" autocomplete="off" placeholder="Select a project for recipients…" value="<%= sentEmail ? sentEmail.to : '' %>" <%= sentEmail ? "readonly" : "" %> />
          <button type="button" class="btn-copy" data-copy="hhsrs-to">Copy</button>
        </div>
        <div class="field-with-copy">
          <label for="hhsrs-cc">Cc</label>
          <input id="hhsrs-cc" name="hhsrs-cc" type="text" inputmode="email" autocomplete="off" placeholder="optional" value="<%= sentEmail ? sentEmail.cc : '' %>" <%= sentEmail ? "readonly" : "" %> />
          <button type="button" class="btn-copy" data-copy="hhsrs-cc">Copy</button>
        </div>
        <div class="field-with-copy">
          <label for="hhsrs-bcc">Bcc</label>
          <input id="hhsrs-bcc" name="hhsrs-bcc" type="text" inputmode="email" autocomplete="off" placeholder="optional" value="<%= sentEmail ? sentEmail.bcc : '' %>" <%= sentEmail ? "readonly" : "" %> />
          <button type="button" class="btn-copy" data-copy="hhsrs-bcc">Copy</button>
        </div>
        <div class="field-with-copy">
          <label for="hhsrs-subject">Subject</label>
          <input id="hhsrs-subject" name="hhsrs-subject" type="text" autocomplete="off" placeholder="Subject" value="<%= sentEmail ? sentEmail.subject : '' %>" <%= sentEmail ? "readonly" : "" %> />
          <button type="button" class="btn-copy" data-copy="hhsrs-subject">Copy</button>
        </div>
        <div class="field-with-copy">
          <label for="hhsrs-body">Body</label>
          <textarea id="hhsrs-body" name="hhsrs-body" autocomplete="off" placeholder="Draft email…" <%= sentEmail ? "readonly" : "" %>><%= sentEmail ? sentEmail.body : "" %></textarea>
          <button type="button" class="btn-copy" data-copy="hhsrs-body">Copy</button>
        </div>
        <% if (isFilled) { %>
          <div class="attach-block" id="rv-attach-block">
            <div class="attach-head">
              <label id="rv-attach-label">Attachments</label>
              <span class="attach-count" id="rv-attach-count" aria-live="polite"><% if (casePhotos.length) { %><%= casePhotos.length %> of <%= casePhotos.length %> attached<% } %></span>
            </div>
            <div class="attach-list" id="rv-attach-list" role="group" aria-labelledby="rv-attach-label">
              <% if (!casePhotos.length) { %>
                <p class="attach-none">No photos.</p>
              <% } %>
              <% casePhotos.forEach((p) => {
                const attached = !sentEmail || sentEmail.photoNames.map(String).includes(p.name);
              %>
                <figure class="attach-item <%= attached ? 'is-on' : '' %>">
                  <img src="<%= p.url %>" alt="<%= p.caption %>" draggable="false" />
                  <figcaption class="attach-name"><%= p.name %></figcaption>
                  <label class="attach-tick">
                    <input type="checkbox" <%= attached ? "checked" : "" %> <%= sentEmail ? "disabled" : "" %> data-attach-name="<%= p.name %>" data-bytes="<%= p.bytes || 0 %>" />
                    Attach
                  </label>
                </figure>
              <% }) %>
            </div>
          </div>
        <% } %>
        <div id="rv-email-photos" class="email-photo-tools" hidden>
          <div class="photo-thumbs email-photo-thumbs" id="rv-email-photo-thumbs" aria-label="Drag case photos into your email draft"></div>
          <p class="photos-drag-hint" id="rv-photos-hint">Drag a photo into your email draft. If that doesn’t work, download the photo.</p>
          <div class="photos-fallback">
            <button type="button" class="btn btn-sm btn-photo-fallback" id="btn-download-photos" disabled>Download photos</button>
          </div>
        </div>
        <p class="signature-added-note" id="rv-signature-note">Signature added when sent</p>
        <p class="review-project-hint email-empty-hint" id="rv-email-empty-hint" <%= sentEmail ? "hidden" : "" %>>Fill case details, then click Generate email below Case details.</p>
      </form>
    </section>
  </div>

  <section class="finish-bar" id="rv-finish-bar" aria-label="Finish this case">
    <div class="finish-bar-left">
      <% if (showNotNeeded) { %>
        <button type="button" class="btn btn-not-needed" id="btn-not-needed">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="7" width="12" height="13" rx="1.4"/><path d="M6 16.5V5.5h10"/><path d="m11.2 11.2 5.2 5.2M16.4 11.2l-5.2 5.2"/></svg>
          Not needed
        </button>
        <p class="finish-hint">Duplicate, error or test</p>
      <% } %>
    </div>
    <div class="finish-bar-right">
      <div class="send-block" id="rv-send-block">
        <p class="finish-hint send-line" id="rv-send-line"><% if (sentEmail) { %>Sent and logged in the Main Log. Can't be sent again.<% } else if (caseNotNeeded) { %>Move it back to Pending before sending.<% } else if (!sendConfig.configured) { %>Sending not set up yet.<% } else { %>Sends the email and adds it to the Main Log.<% } %></p>
        <button type="button" class="btn btn-primary btn-send <%= sentEmail ? 'is-sent' : '' %>" id="btn-send-email" <%= (sentEmail || caseNotNeeded) ? "disabled" : "" %> data-not-needed="<%= caseNotNeeded ? "1" : "" %>" aria-describedby="rv-send-line"><%= sentEmail ? "✓ Sent and logged" : "Send and log" %></button>
      </div>
    </div>
  </section>
</div>

<p class="footer-note">Review &amp; Create · Project extras are stubbed from desktop rules · Live drafts from site submissions</p>

<% if (!sentEmail && !caseNotNeeded) { %>
<div class="ck-overlay" id="ck-overlay" hidden>
  <div class="ck-dialog" role="dialog" aria-modal="true" aria-labelledby="ck-title">
    <form id="rv-send-form" autocomplete="off" method="post" action="<%= isFilled ? reporterBase + '/review/' + row.id + '/send' : reporterBase + '/review/office-send' %>">
      <div class="ck-head"><h2 id="ck-title" tabindex="-1">Check Before Sending</h2></div>
      <div class="ck-body" id="ck-body">
        <% if (sendConfig.testMode) { %>
          <p class="ck-test" id="ck-test"><%= sendConfig.testBanner %></p>
        <% } %>
      </div>
      <div class="ck-body" style="padding-top:0">
        <label class="ck-tick" id="ck-tick-label" for="ck-tick">
          <input type="checkbox" id="ck-tick" name="checked" value="1" />
          I've checked the details
        </label>
        <p class="ck-safe">Nothing is sent until you press Send and log.</p>
      </div>
      <input type="hidden" name="to" id="rv-send-to" value="" autocomplete="off" />
      <input type="hidden" name="cc" id="rv-send-cc" value="" autocomplete="off" />
      <input type="hidden" name="bcc" id="rv-send-bcc" value="" autocomplete="off" />
      <input type="hidden" name="subject" id="rv-send-subject" value="" autocomplete="off" />
      <input type="hidden" name="body" id="rv-send-body" value="" autocomplete="off" />
      <div id="rv-send-photo-fields"></div>
      <div class="ck-foot">
        <button type="button" class="btn btn-back" id="ck-back">Go back</button>
        <button type="submit" class="btn btn-primary" id="ck-send" disabled>Send and log</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<% if (showNotNeeded) { %>
<div class="nn-overlay" id="nn-overlay" hidden>
  <div class="nn-dialog" role="dialog" aria-modal="true" aria-labelledby="nn-title">
    <form id="nn-form" method="post" action="<%= reporterBase %>/review/<%= row.id %>/not-needed" data-ref="<%= row.reference || '' %>">
      <h2 id="nn-title">Move to Duplicates &amp; Errors?</h2>
      <p class="nn-case">
        <% if (row.reference) { %><span class="ref-chip"><%= row.reference %></span><% } %>
        <%= row.fullAddress %><% if (row.postcode) { %>, <%= row.postcode %><% } %> · <%= row.category %>
      </p>
      <fieldset class="nn-reasons-set">
        <legend>Reason <abbr title="required">*</abbr></legend>
        <div class="nn-reasons">
          <% (typeof notNeededReasons !== "undefined" ? notNeededReasons : []).forEach((item) => { %>
            <label class="nn-reason">
              <input type="radio" name="reason" value="<%= item.id %>" />
              <span class="nn-reason-copy"><strong><%= item.label %></strong><span><%= item.hint %></span></span>
            </label>
          <% }) %>
        </div>
      </fieldset>
      <label class="nn-field" id="nn-dup-field" hidden>
        Duplicate of (reference) <abbr title="required">*</abbr>
        <input name="duplicateOf" id="nn-duplicate-of" class="nn-ref" placeholder="e.g. MTVH-012" autocomplete="off" />
      </label>
      <label class="nn-field" id="nn-note-field" hidden>
        Note <span id="nn-note-req" hidden><abbr title="required">*</abbr></span>
        <textarea name="note" id="nn-note" rows="3" placeholder="Optional"></textarea>
      </label>
      <p class="nn-safe">✓ Nothing is deleted. You can move it back.</p>
      <div class="nn-foot">
        <button type="button" class="btn btn-back" id="nn-cancel">Cancel</button>
        <button type="submit" class="btn btn-primary" id="nn-move" disabled>Move</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<%- include("partials/layout-close") %>
