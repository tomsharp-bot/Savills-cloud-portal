<%- include("partials/layout-open") %>

<div class="page-header">
  <div>
    <h2 class="page-section-title">Admin</h2>
    <p class="subtitle">Site form link, client email, desktop alerts, and project settings.</p>
  </div>
  <div class="header-meta">
    <strong>Admin</strong>
    Portal · live shell
  </div>
</div>

<h2 class="page-section-title section-bar">
  <span class="section-bar-label">Surveyor Site Form Link</span>
  <span class="count count-review">Share</span>
</h2>
<section class="panel site-link-panel" aria-label="Surveyor Site Form Link">
  <div class="site-link-box">
    <p class="site-link-help">Give surveyors this link to open the phone site form (no login). Copy and send by email or WhatsApp.</p>
    <div class="site-link-row">
      <input type="text" id="admin-site-form-url" class="site-link-input" readonly value="<%= siteFormPublicUrl %>" aria-label="Surveyor site form URL" />
      <button type="button" class="btn btn-primary btn-sm" id="btn-copy-site-form-link">Copy link</button>
    </div>
    <p class="site-link-status" id="copy-site-form-status" aria-live="polite"></p>
  </div>
</section>

<%- include("partials/client-email-card") %>

<h2 class="page-section-title section-bar">
  <span class="section-bar-label">Desktop Alerts</span>
  <span class="count count-review" id="admin-alerts-badge">Off</span>
</h2>
<section class="panel" aria-label="Desktop Alerts">
  <div class="admin-alerts-box">
    <div class="admin-alerts-row">
      <div class="admin-alerts-status">
        <span class="admin-alerts-dot is-off" id="admin-alerts-dot" aria-hidden="true"></span>
        <p class="admin-alerts-label" id="admin-alerts-status-text">Desktop alerts are off</p>
      </div>
      <div class="admin-alerts-actions">
        <button type="button" class="btn btn-sm btn-enable-alerts" id="btn-admin-enable-desktop-alerts">Enable desktop alerts</button>
        <button type="button" class="btn btn-sm btn-enable-alerts" id="btn-admin-send-test-alert">Send test alert</button>
      </div>
    </div>
    <p class="admin-alerts-hint" id="admin-alerts-hint">Desktop alerts are required. Enable them on this page.</p>
    <p class="admin-alerts-test-help" id="admin-alerts-test-help">No pop-up? Turn on notifications for this browser in Windows Settings > System > Notifications, and make sure Do not disturb is off.</p>
    <p class="admin-alerts-note" id="admin-alerts-sim-note" hidden>
      Testing:
      <button type="button" class="btn btn-ghost btn-sm" id="btn-admin-simulate-alerts-off">Simulate alerts turned off</button>
      Browser permission stays as it is.
    </p>
  </div>
</section>

<%
  const archived = Array.isArray(archivedProjects) ? archivedProjects : [];
%>
<h2 class="page-section-title section-bar" id="archived-projects">
  <span class="section-bar-label">Project Settings</span>
  <span class="count count-review"><%= archived.length %></span>
</h2>
<section class="panel" aria-label="Project settings">
  <p class="ps-help">Archived projects stay on file. Reinstate puts one back to current so surveyors see it on the site form again.</p>
  <% if (!archived.length) { %>
    <p class="ps-empty">No archived projects.</p>
  <% } else { %>
    <ul class="ps-archived-list">
      <% archived.forEach(function (project) { %>
        <li>
          <div>
            <p class="ps-archived-name"><%= project.name %></p>
            <p class="ps-archived-meta"><%= project.projectManager %></p>
          </div>
          <form method="post" action="<%= reporterBase %>/project-settings/reinstate">
            <input type="hidden" name="projectId" value="<%= project.id %>" />
            <button type="submit" class="btn btn-primary btn-sm">Reinstate</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<p class="footer-note">Admin · Reinstate does not delete anything</p>

<%- include("partials/layout-close") %>
