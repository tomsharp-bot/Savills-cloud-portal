<%- include("partials/layout-open") %>
<%
  const selected = typeof found !== "undefined" ? found : null;
  const amending = view === "amend" && selected && amend;
  const closeUrl = reporterBase + "/find" + (filters.q || filters.date || filters.project
    ? "?" + [
        filters.q ? "q=" + encodeURIComponent(filters.q) : "",
        filters.date ? "date=" + encodeURIComponent(filters.date) : "",
        filters.project ? "project=" + encodeURIComponent(filters.project) : ""
      ].filter(Boolean).join("&")
    : "");
%>

<% if (!amending) { %>
<div class="find-page<%= selected ? " has-case" : "" %>">
<div class="find-split<%= selected ? " has-case" : "" %>">
<div class="find-main">
<div class="page-header">
  <div>
    <h2 class="page-section-title">Find and resend</h2>
    <p class="subtitle">Click a case. The email that was sent opens on the right.</p>
  </div>
</div>

<section class="panel">
  <div class="panel-head"><h2>Find a case</h2></div>
  <form class="panel-body find-body" method="get" action="<%= reporterBase %>/find">
    <div class="find-search">
      <div>
        <label class="find-label" for="find-q">Reference, UPRN or address</label>
        <input id="find-q" name="q" type="text" value="<%= filters.q %>" placeholder="e.g. MTVH-011, 10010120, Moor" autocomplete="off" />
      </div>
      <div>
        <label class="find-label" for="find-project">Project</label>
        <select id="find-project" name="project">
          <option value="">All projects</option>
          <% (Array.isArray(projectNames) ? projectNames : []).forEach((name) => { %>
            <option value="<%= name %>" <%= filters.project === name ? "selected" : "" %>><%= name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="find-label" for="find-date">Date submitted</label>
        <input id="find-date" name="date" type="date" value="<%= filters.date %>" />
      </div>
      <button type="submit" class="btn btn-primary">Search</button>
      <a class="btn btn-ghost" href="<%= reporterBase %>/find">Clear</a>
    </div>
    <p class="find-hint">Search by reference, UPRN, or address. The project list is the same one the site form uses.</p>
  </form>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>Results</h2>
    <span class="count"><%= rows.length %> found</span>
  </div>
  <% if (!rows.length) { %>
    <p class="empty" style="padding:1rem 1.1rem;">No cases found.</p>
  <% } else { %>
    <%- include("partials/pending-issues-table", {
      pendingRows: rows,
      pendingTableId: "find-table",
      pendingAction: "amend",
      pendingFoot: "Newest first"
    }) %>
  <% } %>
</section>
</div>

<% if (selected) { %>
<aside class="fr-drawer" id="fr-drawer" aria-label="Case">
  <div class="fr-drawer-top">
    <% if (selected.reference) { %><span class="ref-chip"><%= selected.reference %></span><% } %>
    <div class="fr-drawer-actions">
      <% if (selected.sent) { %>
        <a class="btn btn-primary" href="<%= selected.amendUrl %>">Amend &amp; resend</a>
      <% } %>
      <a class="fr-x" id="fr-close" href="<%= closeUrl %>" aria-label="Close">×</a>
    </div>
  </div>
  <% if (selected.notice) { %>
    <div class="find-ok">
      <b>Correction sent</b>
      <p><%= selected.notice %></p>
    </div>
  <% } %>
  <% if (!selected.sent) { %>
    <div class="find-info">
      <b>Not sent yet</b>
      <p><%= selected.address %> · <%= selected.hazard %>. Open it in Review and create.</p>
    </div>
    <div class="fr-foot">
      <a class="btn btn-primary" href="<%= selected.reviewUrl %>">Open in Review and create</a>
    </div>
  <% } else { %>
    <%- include("partials/sent-email-card", {
      cardLabel: "Email that was sent",
      card: {
        subject: selected.sent.subject,
        bodyHtml: selected.sent.bodyHtml,
        signatureHtml: typeof signatureHtml !== "undefined" ? signatureHtml : "",
        signatureId: "rv-signature-preview",
        photos: selected.sent.photos
      }
    }) %>
    <% if (selected.log && selected.log.length) { %>
      <div class="fr-log">
        <div class="fr-log-title">Sends</div>
        <% selected.log.forEach((entry) => { %>
          <p class="<%= entry.fresh ? "is-fresh" : "" %>">
            <b><%= entry.when %></b> <%= entry.type %>
            <% if (entry.reason) { %> · <%= entry.reason %><% } %>
          </p>
        <% }) %>
      </div>
    <% } %>
  <% } %>
</aside>
<% } %>
</div>
</div>
<% } else { %>
<section class="amend-screen" id="fr-amend">
  <div class="page-header">
    <div>
      <h2 class="page-section-title">Amend &amp; resend</h2>
      <p class="subtitle">Starts from the email that was sent.<% if (selected.reference) { %> <%= selected.reference %>.<% } %></p>
    </div>
  </div>
  <form id="rv-send-form" autocomplete="off" class="amend-form" method="post" action="<%= amend.action %>">
    <input type="hidden" name="amendmentFields" value="1" />
    <input type="hidden" name="to" value="<%= amend.to %>" autocomplete="off" />
    <input type="hidden" name="cc" value="<%= amend.cc %>" autocomplete="off" />
    <input type="hidden" name="bcc" value="<%= amend.bcc %>" autocomplete="off" />
    <input type="hidden" name="q" value="<%= filters.q %>" />
    <input type="hidden" name="date" value="<%= filters.date %>" />
    <input type="hidden" name="project" value="<%= filters.project || "" %>" />
    <% amend.photos.forEach((photo) => { %>
      <input type="hidden" name="photo" value="<%= photo.name %>" />
    <% }) %>

    <div class="amend-box">
      <div class="amend-head">
        <div class="sent-sec">Amendment</div>
        <label class="amend-why">
          <input id="f-amendment" name="amendment" type="text" autocomplete="off" value="" />
        </label>
      </div>
      <label>Address<input id="f-address" name="address" type="text" autocomplete="off" value="<%= amend.fields.address %>" /></label>
      <label>UPRN<input id="f-uprn" name="uprn" type="text" autocomplete="off" value="<%= amend.fields.uprn %>" /></label>
      <label>Hazard
        <select id="f-hazard" name="hazard" autocomplete="off">
          <% if (!amend.fields.hazard) { %><option value="">Choose</option><% } %>
          <% amend.categories.forEach((name) => { %>
            <option value="<%= name %>" <%= amend.fields.hazard === name ? "selected" : "" %>><%= name %></option>
          <% }) %>
        </select>
      </label>
      <label>Rating
        <select id="f-rating" name="rating" autocomplete="off">
          <% if (!amend.fields.rating) { %><option value="">Choose</option><% } %>
          <% amend.ratings.forEach((name) => { %>
            <option value="<%= name %>" <%= amend.fields.rating === name ? "selected" : "" %>><%= name %></option>
          <% }) %>
        </select>
      </label>
      <label>Site notes<input id="f-notes" name="notes" type="text" autocomplete="off" value="<%= amend.fields.notes %>" /></label>
      <label>Survey date<input id="f-date" name="surveyDate" type="text" autocomplete="off" value="<%= amend.fields.surveyDate %>" /></label>
    </div>

    <article class="sent-card" id="fr-preview" aria-label="Correction email">
      <h2 id="fr-preview-subject"><%= amend.subject %></h2>
      <div class="sent-body">
        <div class="sent-copy" id="fr-preview-copy"><%- amend.previewHtml %></div>
        <div class="sent-sign" id="rv-signature-preview"><%- typeof signatureHtml !== "undefined" ? signatureHtml : "" %></div>
        <% if (amend.photos.length) { %>
          <div class="sent-photos" id="fr-preview-photos">
            <% amend.photos.forEach((photo) => { %>
              <figure class="photo-zoom">
                <div class="art">
                  <% if (photo.url) { %><img src="<%= photo.url %>" alt="<%= photo.caption || photo.name %>" /><% } else { %><div class="art-miss">No file</div><% } %>
                </div>
                <figcaption><%= photo.caption || photo.name %></figcaption>
              </figure>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>

    <label class="amend-check" for="fr-checked">
      <input type="checkbox" id="fr-checked" name="checked" value="1" />
      I've checked the details
    </label>
    <p class="amend-note">Nothing is sent until you press Send correction.</p>
    <div class="amend-actions">
      <a class="btn btn-ghost" href="<%= selected.backUrl %>">Back</a>
      <button type="submit" class="btn btn-primary" id="btn-send-correction" disabled>Send correction</button>
    </div>
  </form>
  <script type="application/json" id="fr-amend-data"><%- JSON.stringify({
    previous: amend.fields,
    extras: amend.extras,
    prose: amend.prose,
    previousSubject: amend.previousSubject
  }).replace(/</g, "\\u003c") %></script>
</section>
<% } %>

<script src="<%= baseUrl('/js/hhsrs-find.js') %>"></script>
<%- include("partials/layout-close") %>
