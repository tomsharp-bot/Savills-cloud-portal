<%- include("partials/layout-open") %>
<%
  const rows = Array.isArray(comparisons) ? comparisons : [];
%>

<div class="dup-compare">
  <div class="page-header">
    <div>
      <h2 class="page-section-title">Duplicates &amp; errors</h2>
      <p class="subtitle">Click the later case to compare it with the one already sent.</p>
    </div>
  </div>

  <div class="dup-table-wrap">
    <table class="dup-table">
      <thead>
        <tr>
          <th>Address</th>
          <th>UPRN</th>
          <th>Matches</th>
          <th>Where the first is</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td class="dup-empty" colspan="5">No cases.</td></tr>
        <% } %>
        <% rows.forEach((item) => { %>
          <tr class="dup-row <%= item.open ? "is-open" : "" %>" <% if (item.canCompare) { %>data-dup-id="<%= item.id %>" tabindex="0"<% } %>>
            <td><%= item.address %></td>
            <td><%= item.uprn %></td>
            <td><%= item.matches %></td>
            <td><%= item.whereFirst %></td>
            <td class="dup-action">
              <% if (item.canCompare) { %>
                <button type="button" class="btn btn-sm" data-dup-toggle="<%= item.id %>"><%= item.open ? "Close duplicate" : "View duplicate" %></button>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% rows.forEach((item) => { if (!item.canCompare || !item.left || !item.right) return; %>
    <div class="dup-pair <%= item.open ? "is-open" : "" %>" id="dup-pair-<%= item.id %>" data-pair-id="<%= item.id %>">
      <article class="dup-card">
        <h3 class="page-section-title"><%= item.left.heading %></h3>
        <div class="dup-body">
          <dl>
            <dt>Address</dt><dd><%= item.left.address %></dd>
            <dt>UPRN</dt><dd><%= item.left.uprn %></dd>
            <dt>Hazard</dt><dd><%= item.left.hazard %></dd>
            <dt>Rating</dt><dd><%= item.left.rating %></dd>
            <dt>Site notes</dt><dd><%= item.left.siteNotes %></dd>
            <dt>Survey date</dt><dd><%= item.left.surveyDate %></dd>
          </dl>
        </div>
      </article>
      <article class="dup-card">
        <h3 class="page-section-title"><%= item.right.heading %></h3>
        <div class="dup-body">
          <dl>
            <dt>Address</dt><dd<% if (item.diff.address) { %> class="diff"<% } %>><%= item.right.address %></dd>
            <dt>UPRN</dt><dd<% if (item.diff.uprn) { %> class="diff"<% } %>><%= item.right.uprn %></dd>
            <dt>Hazard</dt><dd<% if (item.diff.hazard) { %> class="diff"<% } %>><%= item.right.hazard %></dd>
            <dt>Rating</dt><dd<% if (item.diff.rating) { %> class="diff"<% } %>><%= item.right.rating %></dd>
            <dt>Site notes</dt><dd<% if (item.diff.siteNotes) { %> class="diff"<% } %>><%= item.right.siteNotes %></dd>
            <dt>Survey date</dt><dd<% if (item.diff.surveyDate) { %> class="diff"<% } %>><%= item.right.surveyDate %></dd>
          </dl>
        </div>
        <% if (item.amendUrl) { %>
          <div class="dup-foot"><a class="btn" href="<%= item.amendUrl %>">Amend and resend</a></div>
        <% } %>
      </article>
    </div>
  <% }) %>
</div>

<script src="<%= duplicatesJsUrl %>"></script>
<%- include("partials/layout-close") %>
