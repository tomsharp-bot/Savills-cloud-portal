<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>HHSRS Reporter — Savills Cloud Portal</title>
  <%- include("../partials/head-css") %>
</head>
<body>
<div id="screen-app">
  <%- include("../partials/topbar") %>
  <div class="main">
    <section>
      <div class="toolbar">
        <div>
          <h2 class="page-title">HHSRS Reporter</h2>
          <p class="page-sub">Shared queue of site-form submissions. Edit the case, prepare the client email draft, then copy into Outlook and attach photos.</p>
        </div>
      </div>
      <% if (flashOk) { %><p class="flash flash-ok"><%= flashOk %></p><% } %>
      <% if (flashErr) { %><p class="flash flash-err"><%= flashErr %></p><% } %>
      <form class="filters archive-filters" method="get" action="<%= reporterBase %>">
        <label>Status
          <select name="status" onchange="this.form.submit()">
            <option value="">All</option>
            <% statuses.forEach((s) => { %>
              <option value="<%= s %>" <%= statusFilter === s ? "selected" : "" %>><%= statusLabel(s) %></option>
            <% }) %>
          </select>
        </label>
      </form>
      <% if (!rows.length) { %>
        <p class="empty">No submissions in this queue yet.</p>
      <% } else { %>
        <div class="archive-table-wrap">
          <table class="archive-table">
            <thead>
              <tr>
                <th>Submitted</th>
                <th>Status</th>
                <th>Project</th>
                <th>Survey date</th>
                <th>UPRN</th>
                <th>Address</th>
                <th>Category</th>
                <th>Rating</th>
                <th>Surveyor</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach((row) => { %>
                <tr>
                  <td><%= formatDocDate(row.createdAt) %></td>
                  <td><span class="stage-tag stage-<%= row.status === 'email_sent' || row.status === 'closed' ? 'archive' : (row.status === 'new' ? 'upcoming' : 'current') %>"><%= statusLabel(row.status) %></span></td>
                  <td><%= row.projectName %></td>
                  <td><%= row.surveyDate %></td>
                  <td><%= row.uprn %></td>
                  <td><%= row.fullAddress %></td>
                  <td><%= row.category %></td>
                  <td><%= row.rating %></td>
                  <td><%= row.surveyorName %></td>
                  <td><a class="linkish dark" href="<%= reporterBase + '/' + row.id %>">Open</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <p class="docs-hint">Read-only intake list remains at <a class="linkish dark" href="<%= baseUrl('/hhsrs-submissions') %>">HHSRS site reports</a>.</p>
    </section>
  </div>
</div>
<%- include("../partials/app-scripts") %>
</body>
</html>
