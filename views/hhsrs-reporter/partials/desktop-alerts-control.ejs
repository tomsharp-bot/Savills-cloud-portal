<div class="desktop-alerts-banner" id="desktop-alerts-banner" role="region" aria-label="Desktop alerts" hidden>
  <div class="dab-icon" aria-hidden="true">🔔</div>
  <div class="dab-body">
    <p class="dab-title">Turn on desktop alerts</p>
    <p class="dab-text">Get a Windows notification when a new site issue lands — even if this tab isn’t in front.</p>
