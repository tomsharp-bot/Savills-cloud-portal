  <div class="dab-actions">
    <button type="button" class="btn btn-sm btn-enable-alerts" id="btn-enable-desktop-alerts">Enable desktop alerts</button>
  </div>
  <div id="notif-status" class="notif-status" aria-live="polite" hidden></div>
</div>
