<%
  const n = Math.max(0, Number(count) || 0);
  const photoLabel = n === 1 ? "1 photo attached" : n + " photos attached";
%>
<td class="photo-att-cell">
  <% if (n > 0) { %>
    <span class="photo-att-icon" title="<%= photoLabel %>" aria-label="<%= photoLabel %>" role="img">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9 3.5h6l1.2 1.8H19a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7.3a2 2 0 0 1 2-2h2.8L9 3.5zm3 4.3A4.7 4.7 0 1 0 16.7 12.5 4.7 4.7 0 0 0 12 7.8zm0 2a2.7 2.7 0 1 1-2.7 2.7A2.7 2.7 0 0 1 12 9.8z"/></svg>
      <span class="photo-att-count"><%= n %></span>
    </span>
  <% } %>
</td>
