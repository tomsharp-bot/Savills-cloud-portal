<section class="panel site-access-panel" aria-label="Site form access code">
  <div class="panel-head neutral">
    <h2>Site form access code</h2>
  </div>
  <div class="site-access-box">
    <p class="site-access-help">Surveyors enter this once on each phone.</p>
    <div class="site-access-code-row">
      <p class="site-access-code" id="site-access-code" data-code="<%= siteFormAccessCode %>">••••••</p>
      <button type="button" class="btn btn-ghost btn-sm" id="site-access-toggle" aria-pressed="false">Show</button>
    </div>
    <p class="site-access-meta"><%= siteFormAccessChangedLine %></p>
    <% if (siteFormAccessSaved) { %><p class="site-access-ok">Code changed.</p><% } %>
    <% if (siteFormAccessError) { %><p class="site-access-err" role="alert"><%= siteFormAccessError %></p><% } %>
    <button type="button" class="btn btn-ghost btn-sm" id="site-access-change">Change code</button>
    <form
      id="site-access-form"
      class="site-access-form"
      method="post"
      action="<%= reporterBase %>/admin/site-form-access"
      <% if (!siteFormAccessEditing) { %>hidden<% } %>
    >
      <label for="site-access-new">New code</label>
      <div class="site-access-new-row">
        <input
          id="site-access-new"
          name="code"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          maxlength="6"
          pattern="[0-9]{6}"
          value=""
        />
        <button type="button" class="btn btn-ghost btn-sm" id="site-access-generate">Make one for me</button>
      </div>
      <p class="site-access-warn">All phones will need the new code.</p>
      <div class="site-access-actions">
        <button type="submit" class="btn btn-accent btn-sm">Save</button>
        <button type="button" class="btn btn-ghost btn-sm" id="site-access-cancel">Cancel</button>
      </div>
    </form>
  </div>
</section>
