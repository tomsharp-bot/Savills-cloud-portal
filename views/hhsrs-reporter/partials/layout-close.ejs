        </div><!-- /.content-pane -->
      </div><!-- /.work-panel -->
    </div><!-- /.app-shell -->
  </div><!-- /.stage -->
</div><!-- /#screen-app -->
<div class="alert-toast" id="hhsrs-alert-toast" role="alert" aria-live="assertive" aria-atomic="true">
  <div class="toast-kicker" id="hhsrs-toast-kicker">New hazard</div>
  <p class="toast-title" id="hhsrs-toast-title"></p>
  <p class="toast-body" id="hhsrs-toast-body"></p>
  <div class="toast-actions">
    <a class="btn btn-accent btn-sm" id="hhsrs-toast-open" href="#">Review &amp; Create</a>
    <button type="button" class="btn btn-ghost btn-sm" id="hhsrs-toast-dismiss">Dismiss</button>
  </div>
</div>
<script>
  window.HHSRS_REPORTER = {
    base: <%- JSON.stringify(reporterBase) %>,
    demoProjects: <%- JSON.stringify(typeof demoProjects !== 'undefined' ? demoProjects : null) %>,
    ratingOptions: <%- JSON.stringify(typeof ratingOptions !== 'undefined' ? ratingOptions : null) %>,
    categoryOptions: <%- JSON.stringify(typeof categoryOptions !== 'undefined' ? categoryOptions : null) %>,
    initialProject: <%- JSON.stringify(typeof reviewProjectValue !== 'undefined' ? reviewProjectValue : '') %>,
    mode: <%- JSON.stringify(typeof mode !== 'undefined' ? mode : activeNav) %>,
    caseId: <%- JSON.stringify(typeof row !== 'undefined' && row ? row.id : '') %>,
    casePhotos: <%- JSON.stringify(typeof photos !== 'undefined' ? photos : []) %>,
    initialPendingIds: <%- JSON.stringify(typeof initialPendingIds !== 'undefined' ? initialPendingIds : null) %>,
    reviewProjects: <%- JSON.stringify(typeof reviewProjectNames !== 'undefined' ? reviewProjectNames : []) %>,
    projectAliases: <%- JSON.stringify(typeof projectAliases !== 'undefined' ? projectAliases : {}) %>,
    waitingIds: <%- JSON.stringify(typeof waitingIds !== 'undefined' ? waitingIds : []) %>,
    alertsPollMs: 30000,
    send: <%- JSON.stringify(typeof sendConfig !== 'undefined' ? sendConfig : null) %>,
    signature: <%- JSON.stringify(typeof emailSignature !== 'undefined' ? emailSignature : null) %>,
    findResend: <%- JSON.stringify(typeof findResend !== 'undefined' ? findResend : false) %>,
    surveyorCheck: <%- JSON.stringify(typeof surveyorCheck !== 'undefined' ? surveyorCheck : null) %>,
    serverDraft: <%- JSON.stringify({
      to: typeof draftTo !== 'undefined' ? draftTo : '',
      cc: typeof draftCc !== 'undefined' ? draftCc : '',
      bcc: typeof draftBcc !== 'undefined' ? draftBcc : '',
      subject: typeof draftSubject !== 'undefined' ? draftSubject : '',
      body: typeof draftBody !== 'undefined' ? draftBody : ''
    }) %>
  };
</script>
<script src="<%= baseUrl('/js/hhsrs-pending-alerts.js') %>" defer></script>
<script src="<%= baseUrl('/js/date-search-year.js') %>" defer></script>
<script src="<%= reporterJsUrl %>" defer></script>
<script src="<%= hazardListsJsUrl %>" defer></script>
</body>
</html>
