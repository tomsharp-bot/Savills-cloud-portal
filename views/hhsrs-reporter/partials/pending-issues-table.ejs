<%
  const rows = Array.isArray(pendingRows) ? pendingRows : [];
  const tableId = typeof pendingTableId === "string" ? pendingTableId : "waiting-table";
  const wrapId = typeof pendingWrapId === "string" ? pendingWrapId : "";
  const action = typeof pendingAction === "string" ? pendingAction : "review";
  const foot = typeof pendingFoot === "string" ? pendingFoot : "Newest first";
  const showPhotoCount = typeof pendingShowPhotoCount !== "undefined" && pendingShowPhotoCount === true;
  const showReference = typeof pendingShowReference === "undefined" || pendingShowReference !== false;
  const showClaim = typeof pendingShowClaim === "undefined" || pendingShowClaim !== false;
  const showActioned = typeof pendingShowActioned !== "undefined" && pendingShowActioned === true;
  const sortColumns = typeof pendingSortColumns !== "undefined" && Array.isArray(pendingSortColumns) ? pendingSortColumns : [];
%>
<div class="table-wrap pending-issues-wrap"<% if (wrapId) { %> id="<%= wrapId %>"<% } %>>
  <table class="landing-table pending-issues-table<%= showReference ? "" : " is-noref" %>" id="<%= tableId %>">
    <colgroup>
      <% if (showReference) { %><col class="c-ref" /><% } %><col class="c-proj" /><col class="c-addr" /><col class="c-ph" />
      <col class="c-uprn" /><col class="c-surv" /><col class="c-cat" /><col class="c-rate" />
      <% if (showActioned) { %><col class="c-actioned" /><col class="c-by" /><% } %>
      <col class="c-when" /><col class="c-act" />
    </colgroup>
    <thead>
      <tr>
        <% if (sortColumns.length) { %>
          <% sortColumns.forEach((col) => {
            const thClass = [col.className, col.active ? "is-sorted" : ""].filter(Boolean).join(" ");
          %>
            <th class="<%= thClass %>"<% if (col.className === "photo-att-col") { %> scope="col"<% } %> aria-sort="<%= col.active ? (col.dir === "desc" ? "descending" : "ascending") : "none" %>">
              <a class="ml-sort" href="<%= col.href %>" title="<%= col.title %>"><%= col.label %><% if (col.active) { %><span class="ml-sort-ind" aria-hidden="true"><%= col.dir === "desc" ? "▼" : "▲" %></span><% } %></a>
            </th>
          <% }) %>
          <th class="col-act"></th>
        <% } else { %>
          <% if (showReference) { %><th class="col-ref">Reference</th><% } %>
          <th class="col-proj">Project</th>
          <th class="col-addr">Address</th>
          <th class="photo-att-col" scope="col" title="Photos attached">Photos</th>
          <th class="col-uprn">UPRN</th>
          <th class="col-surv">Surveyor</th>
          <th class="col-cat">Category</th>
          <th class="col-rate">Rating</th>
          <th class="col-when">Received</th>
          <th class="col-act"></th>
        <% } %>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach((row) => {
        const ago = formatTimeAgo(row.createdAt);
        const claim = claimView(row);
        const addrFull = splitAddress(String(row.fullAddress || ""), String(row.postcode || "")).full;
        const addrLine = String(row.addressLine || "").trim() || addressFirstLine(addrFull);
        const addrShown = addrFull || addrLine;
      %>
        <tr class="<%= [showClaim ? claimRowClass(row) : "", row.href ? "find-result" : "", row.rowClass || "", row.pendingDupe ? "pending-dupe" : ""].filter(Boolean).join(" ") %>" data-claim-status="<%= showClaim ? claim.status : "open" %>"<% if (row.href) { %> data-href="<%= row.href %>"<% } %>>
          <% if (showReference) { %><td class="col-ref"><% if (row.reference) { %><span class="ref-chip"><%= row.reference %></span><% } else { %>—<% } %></td><% } %>
          <td class="col-proj"><span class="project-pill"><%= row.projectName %></span></td>
          <td class="addr-cell col-addr">
            <span class="ml-addr-hover">
              <strong><%= addrShown %></strong>
              <% if (addrFull && addrLine && addrFull !== addrLine) { %>
                <span class="ml-addr-full"><%= addrFull %></span>
              <% } %>
            </span>
            <% if (row.amendedNote) { %><span class="ml-amended"><%= row.amendedNote %></span><% } %>
            <% if (row.showReviewed) { %><span class="ml-row-note">Reviewed<% if (row.rowNote) { %><span class="ml-row-note-full"><%= row.rowNote %></span><% } %></span><% } %>
            <% if (showClaim) { %><%- include("claim-chip", { claimRow: claim }) %><% } %>
          </td>
          <%- include("photo-att-cell", { count: photoAttachmentCount(row.photoPaths), photoThumbs: reporterCasePhotos(row, reporterBase), showPhotoCount }) %>
          <td class="col-uprn"><span style="color:var(--muted)"><%= row.uprn %></span><% if (row.pendingDupe) { %> <span class="pending-dupe-tag">Dupe</span><% } %></td>
          <td class="col-surv"><%= row.surveyorName %></td>
          <td class="col-cat"><%= row.category %></td>
          <td class="col-rate <%= ratingDisplayClass(row.rating) %>" title="<%= row.rating %>"><%= row.rating %></td>
          <% if (showActioned) { %>
            <td class="col-actioned ml-actioned"><b><%= row.actionedOn || "—" %></b></td>
            <td class="col-by ml-actioned-by"><b><%= row.actionedBy || "—" %></b></td>
          <% } %>
          <td class="col-when">
            <span class="<%= ago.urgent ? 'time-ago-urgent' : '' %>"><%= ago.relative %></span>
            <span class="time-ago-abs"><%= ago.absolute %></span>
          </td>
          <td class="col-act">
            <% if (action === "amend") { %>
              <a class="btn-review-create" href="<%= row.amendUrl %>">Amend</a>
            <% } else if (action === "details") { %>
              <a class="btn-review-create" href="<%= reporterBase %>/main-log/<%= row.id %>/details">View details</a>
            <% } else { %>
              <a class="btn-review-create" href="<%= reporterBase %>/review/<%= row.id %>?claim=1">Review Case</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (foot) { %><div class="table-foot"><span><%- foot %></span></div><% } %>
