<%
  const rows = Array.isArray(pendingRows) ? pendingRows : [];
  const tableId = typeof pendingTableId === "string" ? pendingTableId : "waiting-table";
  const wrapId = typeof pendingWrapId === "string" ? pendingWrapId : "";
  const action = typeof pendingAction === "string" ? pendingAction : "review";
  const foot = typeof pendingFoot === "string" ? pendingFoot : "Newest first";
  const showPhotoCount = typeof pendingShowPhotoCount !== "undefined" && pendingShowPhotoCount === true;
%>
<div class="table-wrap pending-issues-wrap"<% if (wrapId) { %> id="<%= wrapId %>"<% } %>>
  <table class="landing-table pending-issues-table" id="<%= tableId %>">
    <colgroup>
      <col class="c-ref" /><col class="c-proj" /><col class="c-addr" /><col class="c-ph" />
      <col class="c-uprn" /><col class="c-surv" /><col class="c-cat" /><col class="c-rate" />
      <col class="c-when" /><col class="c-act" />
    </colgroup>
    <thead>
      <tr>
        <th>Reference</th>
        <th>Project</th>
        <th>Address</th>
        <th class="photo-att-col" scope="col" title="Photos attached">Photos</th>
        <th>UPRN</th>
        <th>Surveyor</th>
        <th>Category</th>
        <th>Rating</th>
        <th>Received</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach((row) => {
        const ago = formatTimeAgo(row.createdAt);
        const claim = claimView(row);
      %>
        <tr class="<%= [claimRowClass(row), row.href ? "find-result" : "", row.rowClass || ""].filter(Boolean).join(" ") %>" data-claim-status="<%= claim.status %>"<% if (row.href) { %> data-href="<%= row.href %>"<% } %>>
          <td><% if (row.reference) { %><span class="ref-chip"><%= row.reference %></span><% } else { %>—<% } %></td>
          <td><span class="project-pill"><%= row.projectName %></span></td>
          <td class="addr-cell">
            <strong><%= row.fullAddress %></strong>
            <%- include("claim-chip", { claimRow: claim }) %>
          </td>
          <%- include("photo-att-cell", { count: photoAttachmentCount(row.photoPaths), photoThumbs: reporterCasePhotos(row, reporterBase), showPhotoCount }) %>
          <td><span style="color:var(--muted)"><%= row.uprn %></span></td>
          <td><%= row.surveyorName %></td>
          <td><%= row.category %></td>
          <td class="<%= ratingDisplayClass(row.rating) %>"><%= row.rating %></td>
          <td>
            <span class="<%= ago.urgent ? 'time-ago-urgent' : '' %>"><%= ago.relative %></span>
            <span class="time-ago-abs"><%= ago.absolute %></span>
          </td>
          <td>
            <% if (action === "amend") { %>
              <a class="btn-review-create" href="<%= row.amendUrl %>">Amend</a>
            <% } else { %>
              <a class="btn-review-create" href="<%= reporterBase %>/review/<%= row.id %>">Review Case</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (foot) { %><div class="table-foot"><span><%- foot %></span></div><% } %>
