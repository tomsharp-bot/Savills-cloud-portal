<section class="panel client-email-panel" id="client-email-card" aria-label="Client email addresses">
  <div class="panel-head neutral">
    <h2>Client email addresses</h2>
  </div>
  <div class="client-email-box">
    <p class="client-email-help">To, Cc, and Bcc for each project. One address per line, or commas. A project with no To address cannot send.</p>
    <% if (clientEmailFormError) { %><p class="client-email-err" role="alert"><%= clientEmailFormError %></p><% } %>
    <% clientEmailCards.forEach(function (card) { %>
      <form class="client-email-row" method="post" action="<%= reporterBase %>/admin/client-emails">
        <h3><%= card.projectName %></h3>
        <input type="hidden" name="projectName" value="<%= card.projectName %>" />
        <div class="client-email-fields">
          <label for="<%= card.toId %>">To
            <textarea id="<%= card.toId %>" name="to" rows="2" autocomplete="off"><%= card.toText %></textarea>
          </label>
          <label for="<%= card.ccId %>">Cc
            <textarea id="<%= card.ccId %>" name="cc" rows="2" autocomplete="off"><%= card.ccText %></textarea>
          </label>
          <label for="<%= card.bccId %>">Bcc
            <textarea id="<%= card.bccId %>" name="bcc" rows="2" autocomplete="off"><%= card.bccText %></textarea>
          </label>
        </div>
        <div class="client-email-actions">
          <button type="submit" class="btn btn-accent btn-sm">Save</button>
          <% if (card.changedLine) { %><p class="client-email-meta"><%= card.changedLine %></p><% } %>
        </div>
        <% if (card.saved) { %><p class="client-email-ok">Saved.</p><% } %>
        <% if (card.error) { %><p class="client-email-err" role="alert"><%= card.error %></p><% } %>
      </form>
    <% }) %>
  </div>
</section>
