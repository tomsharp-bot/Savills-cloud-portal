<h2 class="page-section-title section-bar">
  <span class="section-bar-label">Client Email Addresses</span>
</h2>
<section class="panel client-email-panel" id="client-email-card" aria-label="Client Email Addresses">
  <div class="client-email-box">
    <p class="client-email-help">Pick a project. One address per line, or commas. A project with no To address cannot send.</p>
    <% if (clientEmailFormError) { %><p class="client-email-err" role="alert"><%= clientEmailFormError %></p><% } %>
    <label class="client-email-project-label" for="client-email-project">Project</label>
    <select id="client-email-project">
      <option value="">Choose a project</option>
      <% clientEmailCards.forEach(function (card) { %>
        <option value="<%= card.projectName %>"<% if (card.open) { %> selected<% } %>><%= card.projectName %></option>
      <% }) %>
    </select>
    <% clientEmailCards.forEach(function (card) { %>
      <form class="client-email-row" autocomplete="off" data-project="<%= card.projectName %>" method="post" action="<%= reporterBase %>/admin/client-emails"<% if (!card.open) { %> hidden<% } %>>
        <input type="hidden" name="projectName" value="<%= card.projectName %>" autocomplete="off" />
        <div class="client-email-fields">
          <label for="<%= card.toId %>">To
            <textarea name="hhsrs-to" rows="3" inputmode="email" autocomplete="off" id="<%= card.toId %>"><%= card.toText %></textarea>
          </label>
          <label for="<%= card.ccId %>">Cc
            <textarea name="hhsrs-cc" rows="3" inputmode="email" autocomplete="off" id="<%= card.ccId %>"><%= card.ccText %></textarea>
          </label>
          <label for="<%= card.bccId %>">Bcc
            <textarea name="hhsrs-bcc" rows="3" inputmode="email" autocomplete="off" id="<%= card.bccId %>"><%= card.bccText %></textarea>
          </label>
        </div>
        <div class="client-email-actions">
          <button type="submit" class="btn btn-accent btn-sm">Save</button>
          <% if (card.changedLine) { %><p class="client-email-meta"><%= card.changedLine %></p><% } %>
        </div>
        <% if (card.saved) { %><p class="client-email-ok">Saved.</p><% } %>
        <% if (card.error) { %><p class="client-email-err" role="alert"><%= card.error %></p><% } %>
      </form>
    <% }) %>
  </div>
</section>
