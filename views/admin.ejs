<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Home — Savills Cloud Portal</title>
  <%- include("partials/head-css") %>
  <link rel="stylesheet" href="<%= baseUrl('/css/programme.css') %>" />
</head>
<body>
<div id="screen-app" class="programme-page">
  <%- include("partials/topbar") %>
  <main class="programme wrap admin-home">
    <div class="head">
      <div>
        <h1>Savills Cloud Portal</h1>
        <p class="intro">Choose a section. Projects Programme stays available from this page and from Project Progress.</p>
      </div>
    </div>
    <div class="admin-grid">
      <a class="admin-tile" href="<%= baseUrl('/HHSRSreporter') %>">
        <h2>HHSRS Reporter</h2>
        <p>Office queue for site-form submissions and client email drafts.</p>
      </a>
      <a class="admin-tile" href="<%= baseUrl('/projects') %>">
        <h2>Project Progress</h2>
        <p>Current, upcoming, and archived survey projects.</p>
      </a>
      <a class="admin-tile" href="<%= baseUrl('/personnel') %>">
        <h2>Personnel</h2>
        <p>Surveyors, clients, and portal administrators.</p>
      </a>
      <a class="admin-tile" href="<%= baseUrl('/photos') %>">
        <h2>Photos</h2>
        <p>Photo Storage — Photos Pool, Photo Folders, extracts, and Client Access.</p>
      </a>
      <a class="admin-tile" href="<%= baseUrl('/projects-programme') %>">
        <h2>Projects Programme</h2>
        <p>Surveyor by week board, with live project numbers below.</p>
      </a>
      <a class="admin-tile" href="<%= baseUrl('/reference-documents') %>">
        <h2>Reference Documents</h2>
        <p>Shared library for surveyors and admins. Upload and delete live here.</p>
      </a>
    </div>
  </main>
</div>
<%- include("partials/pending-alerts") %>
</body>
</html>
